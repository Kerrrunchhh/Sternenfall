{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Übersicht – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    {% if not player.isExtended(now) %}{{ include('_ad.html.twig', {slot: 'overview'}) }}{% endif %}
    <section class="panel vote-reminder" data-vote-reminder hidden>
        {{ include('game/_vote_badge.html.twig') }}
        <p>{{ '<strong>Hilf Starfall zu wachsen!</strong> Stimm einmal am Tag auf BrowserGamesTop ab – jede Stimme bringt das Spiel in der Rangliste nach oben und neue Mitspieler ins Universum.'|trans|raw }}</p>
        <button type="button" class="btn btn-small btn-secondary" data-vote-later>{{ 'Später'|trans }}</button>
    </section>
    {% if attacks is not empty %}
        <section class="panel attack-alarm-panel" role="alert">
            <h2>{{ attacks|length > 1 ? '🚨 Angriffe auf deine Planeten'|trans : '🚨 Angriff auf deine Planeten'|trans }}</h2>
            <table class="table attack-table">
                {% for a in attacks %}
                    {% set f = a.fleet %}
                    {% set intel = incoming_intel[f.id] ?? null %}
                    <tr>
                        <td>
                            {{ '<strong>{owner}</strong> von'|trans({'{owner}': ui.player(f.owner)})|raw }} {% if a.origin %}{{ a.origin.name }} {% endif %}{{ ui.coords(f.coordinates) }}
                            → <strong>{{ a.target ? a.target.name : ('Planet'|trans) }}</strong> {{ ui.coords(f.targetCoordinates) }}
                            {% if intel %}<div class="small">{{ 'erspäht {scoutedAt}:'|trans({'{scoutedAt}': intel.scoutedAt|date('H:i')}) }} {% for s in intel.shipList %}{{ s.count|num }} × {{ s.type.label|trans }}{{ not loop.last ? ', ' }}{% endfor %}</div>{% endif %}
                        </td>
                        <td class="num attack-time">{{ 'Einschlag in {arriveAt}'|trans({'{arriveAt}': ui.countdown(f.arriveAt, now)})|raw }}<br><span class="small">{{ ui.at(f.arriveAt, now) }}</span></td>
                        <td class="num">
                            <form method="post" action="{{ path('app_radar_spy', {id: f.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('radar') }}">
                                <input type="hidden" name="to" value="app_overview">
                                <button class="btn btn-small" type="submit" id="spy-attack-{{ f.id }}" title="{{ 'Die nächste Sonde fliegt der Flotte entgegen und meldet, woraus sie besteht'|trans }}">{{ '🔭 Spionieren'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </section>
    {% endif %}
    {# News the player has not read yet: welcome message and announcements. #}
    {% for n in unread_news %}
        {{ include('game/_news_item.html.twig', {n: n, unread: true, back: 'app_overview'}) }}
    {% endfor %}
    {% if at_trade_posts is not empty %}
        <section class="panel trade-waiting">
            {% for w in at_trade_posts %}
                <a href="{{ path('app_trade_post', {id: w.post.id}) }}" class="trade-waiting-row">
                    <span>{{ '⚖ <strong>{label}</strong> wartet am Handelsstützpunkt <strong>{name}</strong> [{coordinates}]'|trans({'{label}': w.fleet.label|trans|e, '{name}': w.post.name|e, '{coordinates}': w.post.coordinates|e})|raw }}{% if not w.post.owner.sameAs(player) %} {{ 'von {username}'|trans({'{username}': w.post.owner.username}) }}{% endif %}</span>
                    {{ '<span class="trade-waiting-go">Zum Handel →</span>'|trans|raw }} </a>
            {% endfor %}
        </section>
    {% endif %}

    <h1 class="planet-title"><img class="planet-pic" src="{{ asset(planet.picture) }}" alt="{{ planet.fused ? 'Fusion'|trans : planet.type.label|trans }}" width="64" height="64"> {{ planet.name }} <small>[{{ planet.coordinates }}]</small></h1>
    <details class="rename">
        <summary>{{ planet.homeworld ? 'Umbenennen'|trans : 'Umbenennen oder verlassen'|trans }}</summary>
        <form method="post" action="{{ path('app_planet_rename', {id: planet.id}) }}" class="inline-action">
            <input type="hidden" name="_token" value="{{ csrf_token('planet_rename') }}">
            <input type="text" name="name" value="{{ planet.name }}" maxlength="30" required aria-label="{{ 'Neuer Name für {name}'|trans({'{name}': planet.name}) }}">
            <button class="btn btn-small" type="submit" id="planet-rename">{{ 'Speichern'|trans }}</button>
        </form>
        {% if not planet.homeworld and not planet.beingAbandoned %}
            <form method="post" action="{{ path('app_planet_abandon', {id: planet.id}) }}" class="abandon-form">
                <input type="hidden" name="_token" value="{{ csrf_token('planet_abandon') }}">
                <button class="btn btn-small btn-danger" type="submit" name="do" value="abandon" id="planet-abandon"
                        data-confirm="{{ '{name} [{coordinates}] verlassen? Nach 48 Stunden gehört der Planet niemandem mehr – Gebäude, Rohstoffe und die Schiffe im Hangar bleiben herrenlos zurück, jeder kann ihn angreifen und erobern. Solange deine Flotten hier stehen oder hierher zurückkehren, geht das nicht. Bis dahin kannst du abbrechen.'|trans({'{name}': planet.name, '{coordinates}': planet.coordinates}) }}"
                        data-confirm-label="{{ 'Planet verlassen'|trans }}">{{ 'Planet verlassen'|trans }}</button>
            </form>
        {% endif %}
    </details>

    {% if planet.beingAbandoned %}
        <div class="panel warning abandon-warning">
            <div>{{ '<strong>{name} wird verlassen</strong> – in {abandonAt} ({abandonAt2}). Danach ist er herrenlos: Gebäude, Rohstoffe und die Schiffe im Hangar bleiben zurück, jeder kann ihn erobern. Flotten, die dann noch hier stehen, können nur noch umstationieren, solange das Lager Treibstoff und Proviant hergibt – angreifen können sie von hier nicht.'|trans({'{name}': planet.name|e, '{abandonAt}': ui.countdown(planet.abandonAt, now), '{abandonAt2}': ui.at(planet.abandonAt, now)})|raw }}</div>
            <form method="post" action="{{ path('app_planet_abandon', {id: planet.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('planet_abandon') }}">
                <button class="btn btn-small" type="submit" name="do" value="stay" id="planet-stay">{{ 'Doch bleiben'|trans }}</button>
            </form>
        </div>
    {% endif %}
    {% if planet.integrating(now) %}
        <p class="panel warning">{{ '{name} wurde invadiert und geht am {integratedAt} vollständig in deinen Besitz über.'|trans({'{name}': planet.name, '{integratedAt}': planet.integratedAt|date('d.m.Y H:i')}) }}</p>
    {% endif %}
    {# The boxes below, in the player's order (Konto): a grid where wide boxes take a whole row. #}
    <div class="overview-sections">
    {% if player.showsOnOverview('contacts') %}
    <section class="panel quick-contacts ov-wide" style="order: {{ player.overviewPosition('contacts') }}" data-fold="overview-contacts">
        <h2>{{ 'Schnellkontakte'|trans }}
            {%- set online = contacts|filter(c => presence(c) and presence(c).online)|length %}
            <small class="fold-summary muted">{{ (contacts|length == 1 ? '1 Kontakt' : '{count} Kontakte')|trans({'{count}': contacts|length}) }}{% if online > 0 %} · {{ '{count} online'|trans({'{count}': online}) }}{% endif %}{% if unread_mail > 0 %} · <strong>{{ (unread_mail == 1 ? '1 neue Nachricht' : '{count} neue Nachrichten')|trans({'{count}': unread_mail}) }}</strong>{% endif %}{% if contact_requests > 0 %} · <strong>{{ (contact_requests == 1 ? '1 Anfrage' : '{count} Anfragen')|trans({'{count}': contact_requests}) }}</strong>{% endif %}</small>
            <a class="small" href="{{ path('app_mail') }}">{{ 'Post →'|trans }}</a></h2>
        {{ include('game/_contacts.html.twig', {back: 'app_overview'}) }}
    </section>
    {% endif %}
    {% if player.showsOnOverview('movements') %}
    {% if incoming is not empty or own_movements is not empty or guild_deliveries is not empty %}
        <section class="panel movements ov-wide" style="order: {{ player.overviewPosition('movements') }}" data-fold="overview-movements">
            {% set moving = incoming|length + attacks|length + own_movements|length + guild_deliveries|length %}
            {% set hostile = attacks|length %}
            {% set next = (incoming|map(f => f.arriveAt)|merge(attacks|map(a => a.fleet.arriveAt))|merge(own_movements|map(f => f.nextEventAt))|merge(guild_deliveries|map(r => r.guildDeliveryAt)))|sort|first %}
            <h2>{{ 'Flottenbewegungen'|trans }}
                <small class="fold-summary muted">{{ (moving == 1 ? '1 Flotte unterwegs' : '{count} Flotten unterwegs')|trans({'{count}': moving}) }}{% if hostile > 0 %} · <strong class="negative">{{ (hostile == 1 ? '1 Angriff' : '{count} Angriffe')|trans({'{count}': hostile}) }}</strong>{% endif %} · {{ 'nächste in'|trans }} {{ ui.countdown(next, now) }}</small></h2>
            {# One line per movement: what, where, countdown, arrival time, action. #}
            <table class="table movement-table">
                {% for f in incoming %}
                    {% set intel = incoming_intel[f.id] ?? null %}
                    {% set ships = intel ? intel.shipList|map(s => s.count|num ~ ' × ' ~ s.type.label|trans)|join(', ') : '' %}
                    <tr class="{{ f.mission.value == 'attack' ? 'hostile' }}">
                        <td class="movement-what">
                            {% if f.mission.value == 'attack' %}<strong>{{ '⚠ Angriff'|trans }}</strong>{% else %}{{ f.mission.flightLabel|trans }}{% endif %}
                            {{ 'von {owner} → {targetCoordinates}'|trans({'{owner}': ui.player(f.owner), '{targetCoordinates}': ui.coords(f.targetCoordinates)})|raw }}
                            {% if intel %}<span class="small muted" title="{{ 'erspäht {scoutedAt}: {ships}'|trans({'{scoutedAt}': intel.scoutedAt|date('H:i'), '{ships}': ships}) }}">· {{ ships }}</span>
                            {% else %}<a class="small" href="{{ path('app_radar') }}" title="{{ 'Zusammensetzung unbekannt – auf dem Radar ausspionieren'|trans }}">{{ '· 🔭 ausspionieren'|trans }}</a>{% endif %}
                        </td>
                        <td class="num movement-time">{{ ui.countdown(f.arriveAt, now) }}</td>
                        <td class="num small muted movement-time">{{ ui.at(f.arriveAt, now) }}</td>
                        <td></td>
                    </tr>
                {% endfor %}
                {% for f in own_movements %}
                    {% set only = f.shipList|length == 1 ? f.shipList[0].type.value : null %}
                    {% set hover %}{% for s in f.shipList %}{{ s.count|num }} × {{ s.type.label|trans }}{{ not loop.last ? ', ' }}{% endfor %}{% endset %}
                    <tr>
                        <td class="movement-what" title="{{ hover|trim|raw }}">
                            {{ f.named ? f.name : (only == 'scout' ? ('Sonde'|trans) : (only == 'colony_ship' ? ('Kolonieschiff'|trans) : ('Flotte'|trans))) }}:
                            {{ f.mission.flightLabel|trans }}{% if f.mission.value != 'hover' %} {{ f.returning ? ('← zurück nach'|trans) : '→' }} {{ ui.coords(f.returning ? f.coordinates : f.targetCoordinates) }}{% endif %}
                            {# What the fleet carries – trade flights, pickups, loot. #}
                            {% if not f.cargo.empty %}<span class="movement-cargo small muted" title="{{ 'Ladung'|trans }}">📦 {{ ui.goods(f.cargo) }}</span>
                            {% elseif f.hasHold %}<span class="movement-cargo small muted" title="{{ 'Ladung'|trans }}">📦 {{ 'leer'|trans }}</span>{% endif %}
                            {% if f.mission.value == 'pickup' and not f.returning and not f.pickupGoods.empty %}<span class="movement-cargo small muted">📥 {{ 'holt ab: {goods}'|trans({'{goods}': ui.goods(f.pickupGoods)}) }}</span>{% endif %}
                        </td>
                        <td class="num movement-time" title="{{ f.returning ? 'Rückkehr'|trans : (f.mission.value == 'hover' ? 'landet'|trans : 'Ankunft'|trans) }}">{{ ui.countdown(f.nextEventAt, now) }}</td>
                        <td class="num small muted movement-time">{{ ui.at(f.nextEventAt, now) }}</td>
                        <td class="num movement-time">
                            {% if not f.returning and f.owner.id == player.id and recall_until(f) %}
                                <form method="post" action="{{ path('app_fleet_recall', {id: f.id}) }}" class="inline" title="{{ 'Zurückrufen möglich bis {recall_until} (Kommunikationstechnik)'|trans({'{recall_until}': recall_until(f)|date('H:i:s')}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('fleet') }}">
                                    <input type="hidden" name="to" value="app_overview">
                                    <button type="submit" class="link-button recall-link" id="recall-{{ f.id }}">{{ f.mission.value == 'hover' ? ('↓ landen'|trans) : ('↩ zurückrufen'|trans) }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                {% for r in guild_deliveries %}
                    <tr>
                        <td class="movement-what">{{ 'Handelsgilde: {goods} → {coordinates}'|trans({'{goods}': ui.goods(r.goods)|e, '{coordinates}': ui.coords(r.coordinates)})|raw }}</td>
                        <td class="num movement-time" title="{{ 'Ankunft'|trans }}">{{ ui.countdown(r.guildDeliveryAt, now) }}</td>
                        <td class="num small muted movement-time">{{ ui.at(r.guildDeliveryAt, now) }}</td>
                        <td></td>
                    </tr>
                {% endfor %}
            </table>
        </section>
    {% endif %}
    {% endif %}
    {% if player.showsOnOverview('transport_requests') %}
    {% if transport_running is not empty or transport_open > 0 %}
        <section class="panel ov-wide" style="order: {{ player.overviewPosition('transport_requests') }}" data-fold="overview-transport">
            <h2>{{ 'Transportgesuche'|trans }}
                <small class="fold-summary muted">{% if transport_running is not empty %}{{ (transport_running|length == 1 ? '1 läuft' : '{count} laufen')|trans({'{count}': transport_running|length}) }}{% endif %}{% if transport_running is not empty and transport_open > 0 %} · {% endif %}{% if transport_open > 0 %}<strong>{{ (transport_open == 1 ? '1 offenes Gesuch für Händler' : '{count} offene Gesuche für Händler')|trans({'{count}': transport_open}) }}</strong>{% endif %}</small>
                <a class="small" href="{{ path('app_transport_requests') }}">{{ 'Alle Gesuche →'|trans }}</a></h2>
            {% for r in transport_running %}
                <div class="proposal">
                    <div>
                        {{ '{planetName} {coordinates} · {goods} · {offer} Credits'|trans({'{planetName}': r.planetName|e, '{coordinates}': ui.coords(r.coordinates), '{goods}': ui.goods(r.goods)|e, '{offer}': r.offer|num|e})|raw }}
                        <div class="muted small">
                            {{ r.status == 'open' ? ('offen'|trans) : ('wird geliefert'|trans) }}
                            {% if r.requester.id == player.id %}{% if r.trader %} {{ '· Händler {trader}'|trans({'{trader}': ui.player(r.trader)})|raw }}{% endif %}{% else %} {{ '· du lieferst an {requester}'|trans({'{requester}': ui.player(r.requester)})|raw }}{% endif %}
                            {% if r.fleet and r.fleet.moving %} · {{ 'Ankunft in'|trans }} {{ ui.countdown(r.fleet.nextEventAt, now) }}{% elseif r.guildDeliveryAt and r.status == 'assigned' %} · {{ 'Ankunft in'|trans }} {{ ui.countdown(r.guildDeliveryAt, now) }}{% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% if transport_open > 0 %}
                <p class="small"><a href="{{ path('app_transport_requests') }}">{{ (transport_open == 1 ? '1 offenes Gesuch wartet auf einen Händler – beliefern →' : '{count} offene Gesuche warten auf einen Händler – beliefern →')|trans({'{count}': transport_open}) }}</a></p>
            {% endif %}
        </section>
    {% endif %}
    {% endif %}
    {% if player.showsOnOverview('research') %}
    {% if player.researching %}
        <section class="panel ov-wide" style="order: {{ player.overviewPosition('research') }}" data-fold="overview-research">
            <h2>{{ 'Forschung'|trans }}
                <small class="fold-summary muted">{{ '{label} (Stufe {researchTargetLevel})'|trans({'{label}': player.researchType.label|trans, '{researchTargetLevel}': player.researchTargetLevel}) }} · {{ ui.countdown(player.researchFinishesAt, now) }}</small></h2>
            <div class="construction">
                <div>{{ '{label} (Stufe {researchTargetLevel})'|trans({'{label}': player.researchType.label|trans, '{researchTargetLevel}': player.researchTargetLevel}) }}</div>
                <div>{{ ui.countdown(player.researchFinishesAt, now) }}</div>
            </div>
        </section>
    {% endif %}
    {% endif %}
    {% if player.showsOnOverview('ticker') %}
    {{ include('game/_board_ticker.html.twig', {back: 'overview', fold: 'overview-ticker', order: player.overviewPosition('ticker')}) }}
    {% endif %}

    {# Building, shipyard and defense queues. #}
    {% if player.showsOnOverview('queues') %}
    {% if building_queue is not empty or shipyard_queue is not empty or defense_queue is not empty %}
        <div class="grid ov-wide" style="order: {{ player.overviewPosition('queues') }}">
            {% if building_queue is not empty %}{{ include('game/_queue.html.twig', {queue_planet: planet, kind: enum('App\\Game\\QueueKind').Buildings, entries: building_queue, back: 'app_overview', fold: 'overview-queue-buildings'}) }}{% endif %}
            {% if shipyard_queue is not empty %}{{ include('game/_queue.html.twig', {queue_planet: planet, kind: enum('App\\Game\\QueueKind').Shipyard, entries: shipyard_queue, back: 'app_overview', fold: 'overview-queue-shipyard'}) }}{% endif %}
            {% if defense_queue is not empty %}{{ include('game/_queue.html.twig', {queue_planet: planet, kind: enum('App\\Game\\QueueKind').Defense, entries: defense_queue, back: 'app_overview', fold: 'overview-queue-defense'}) }}{% endif %}
        </div>
    {% endif %}
    {% endif %}

        {% if player.showsOnOverview('resources') %}
        <section class="panel" style="order: {{ player.overviewPosition('resources') }}" data-fold="overview-resources">
            {% set short = enum_cases('App\\Game\\ResourceType')|filter(t => net.get(t) < 0) %}
            <h2>{{ 'Rohstoffe pro Stunde'|trans }}
                <small class="fold-summary muted">{% if short is empty %}{{ 'alle Bilanzen positiv'|trans }}{% else %}<strong class="negative">{{ 'im Minus: {labels}'|trans({'{labels}': short|map(t => t.label|trans)|join(', ')}) }}</strong>{% endif %}</small></h2>
            <table class="table">
                <tr class="table-head"><td></td><td class="num">{{ 'Produktion'|trans }}</td><td class="num">{{ 'Verbrauch'|trans }}</td><td class="num">{{ 'Bilanz'|trans }}</td></tr>
                {% for type in enum_cases('App\\Game\\ResourceType') %}
                    {% set balance = net.get(type) %}
                    <tr>
                        <td>{{ type.label|trans }}</td>
                        <td class="num">{{ production.get(type)|num }}</td>
                        <td class="num">{{ consumption.get(type) > 0 ? '−' ~ consumption.get(type)|num : '' }}</td>
                        <td class="num {{ balance < 0 ? 'negative' }}">{{ balance >= 0 ? '+' }}{{ balance|num }}</td>
                    </tr>
                {% endfor %}
            </table>
            {% for type in enum_cases('App\\Game\\ResourceType') %}
                {% set balance = net.get(type) %}
                {% if balance < 0 %}
                    {% set stock = planet.resources.get(type) %}
                    <p class="warning">
                        {% if stock < 1 %}
                            {{ '{label} ist aufgebraucht – deine Bevölkerung hungert und schrumpft!'|trans({'{label}': type.label|trans}) }}
                        {% else %}
                            {{ '{label} reicht noch {value}. Danach beginnt deine Bevölkerung zu schrumpfen.'|trans({'{label}': type.label|trans, '{value}': (stock / -balance * 3600)|format_duration}) }}
                        {% endif %}
                    </p>
                {% endif %}
            {% endfor %}
        </section>
        {% endif %}
        {% if player.showsOnOverview('population') %}
        <section class="panel" style="order: {{ player.overviewPosition('population') }}" data-fold="overview-population">
            <h2>{{ 'Bevölkerung'|trans }}
                <small class="fold-summary muted">{{ '{population} von {capacity} Einwohnern'|trans({'{population}': planet.population|num, '{capacity}': population_capacity|num}) }}</small></h2>
            <table class="table">
                <tr><td>{{ 'Einwohner'|trans }}</td><td class="num">{{ planet.population|num }}</td></tr>
                <tr><td>{{ 'Platz in Biozellen'|trans }}</td><td class="num">{{ population_capacity|num }}</td></tr>
                <tr><td>{{ 'Verbrauch Nahrung'|trans }}</td><td class="num">−{{ consumption.food|num }}/h</td></tr>
                <tr><td>{{ 'Verbrauch Wasser'|trans }}</td><td class="num">−{{ consumption.water|num }}/h</td></tr>
                <tr><td>{{ 'Wachstum'|trans }}</td><td class="num">{{ population_growth > 0 ? '+' ~ population_growth|num ~ '/h' : (population_capacity > 0 ? ('Biozellen voll'|trans) : ('keine Biozelle'|trans)) }}</td></tr>
                <tr><td>{{ 'Bunkerplätze'|trans }}</td><td class="num">{{ bunker_capacity|num }}</td></tr>
            </table>
            {% if planet.population > bunker_capacity %}
                <p class="hint">{{ '{value} Einwohner wären bei einem Bombardement ungeschützt.'|trans({'{value}': (planet.population - bunker_capacity)|num}) }}</p>
            {% endif %}
        </section>
        {% endif %}
        {% if player.showsOnOverview('planet') %}
        <section class="panel" style="order: {{ player.overviewPosition('planet') }}" data-fold="overview-planet">
            <h2>{{ 'Planet'|trans }}
                <small class="fold-summary muted">{{ planet.type.icon }} {{ planet.type.label|trans }} · {{ '{points} Punkte'|trans({'{points}': planet_points(planet)|num}) }}</small></h2>
            <table class="table">
                <tr><td>{{ 'Koordinaten'|trans }}</td><td class="num">{{ planet.coordinates }}</td></tr>
                <tr><td title="{{ 'Jede Gebäudestufe zählt mit dem Punktesatz des Gebäudes'|trans }}">{{ 'Punkte'|trans }}</td><td class="num">{{ planet_points(planet)|num }}</td></tr>
                <tr><td>{{ 'Planetentyp'|trans }}</td><td class="num">{{ planet.type.icon }} {{ planet.type.label|trans }}<br><span class="muted small">{{ planet.type.effect|trans }}{% if planet.fused %}<br>{{ 'Fusion: zählt als blauer Planet, alle Rohstoffe ×1,5'|trans }}{% endif %}</span><br><a class="small" href="{{ path('app_fusion') }}">🔗 {{ planet.fused ? ('Fusion ansehen / sprengen'|trans) : ('Fusion: Vorschau anschweißen'|trans) }}</a></td></tr>
                <tr><td>{{ 'Vor Plünderung geschützt'|trans }}</td><td class="num">{% if protected > 0 %}{{ '{protected} je Rohstoff'|trans({'{protected}': protected|num}) }}{% else %}<a href="{{ path('app_buildings') }}">{{ 'nichts – baue einen Lagerkomplex'|trans }}</a>{% endif %}</td></tr>
            </table>
        </section>
        {% endif %}
        {% if player.showsOnOverview('hangar') %}
        <section class="panel" style="order: {{ player.overviewPosition('hangar') }}" data-fold="overview-hangar">
            {% set hangar_ships = hangar|reduce((sum, e) => sum + e.count, 0) %}
            <h2>{{ 'Hangar'|trans }}
                <small class="fold-summary muted">{{ (hangar_ships == 1 ? '1 Schiff' : '{count} Schiffe')|trans({'{count}': hangar_ships|num}) }}</small></h2>
            {% if hangar is empty %}
                <p class="muted">{{ 'Keine Schiffe stationiert.'|trans }}{% if planet.buildingLevel(enum('App\\Game\\BuildingType').Shipyard) > 0 %} <a href="{{ path('app_shipyard') }}">{{ 'Zur Werft'|trans }}</a>{% endif %}</p>
            {% else %}
                <table class="table">
                    {% for entry in hangar %}
                        <tr><td><a href="{{ path('app_ship_info', {type: entry.type.value}) }}" title="{{ 'Beschreibung und Werte mit deiner Forschung'|trans }}">{{ entry.type.label|trans }}</a></td><td class="num">{{ entry.count|num }}</td></tr>
                    {% endfor %}
                </table>
            {% endif %}
        </section>
        {% endif %}
    </div>
{% endblock %}
