{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Highscores – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% set params = {view: view, sort: sort, lifeform: life_form ? life_form.value : null}|filter(v => v is not null) %}

{% block content %}
    <h1>{{ 'Highscores'|trans }}</h1>

    <nav class="tabs" aria-label="{{ 'Rangliste'|trans }}">
        <a href="{{ path('app_highscores', params|merge({view: 'players'})) }}" class="{{ view == 'players' ? 'active' }}" {{ view == 'players' ? 'aria-current="page"' }}>{{ 'Spieler'|trans }}</a>
        <a href="{{ path('app_highscores', params|merge({view: 'alliances'})) }}" class="{{ view == 'alliances' ? 'active' }}" {{ view == 'alliances' ? 'aria-current="page"' }}>{{ 'Allianzen'|trans }}</a>
    </nav>

    <div class="highscore-filters">
        <span class="muted small">{{ 'Lebensform:'|trans }}</span>
        <a class="filter-chip {{ life_form is null ? 'active' }}" href="{{ path('app_highscores', params|filter((v, k) => k != 'lifeform')) }}">{{ 'Alle'|trans }}</a>
        {% for lf in enum_cases('App\\Game\\LifeForm') %}
            <a class="filter-chip {{ life_form == lf ? 'active' }}" href="{{ path('app_highscores', params|merge({lifeform: lf.value})) }}">{{ lf.icon }} {{ lf.label|trans }}</a>
        {% endfor %}
        <span class="muted small">{{ total|num }} {{ view == 'players' ? ('Spieler'|trans) : (total == 1 ? ('Allianz'|trans) : ('Allianzen'|trans)) }}</span>
    </div>

    <section class="panel">
        {% if rows is empty %}
            <p class="muted">{{ '{Allianzen} mit dieser Lebensform.'|trans({'{Allianzen}': view == 'players' ? ('Keine Spieler'|trans) : ('Keine Allianzen'|trans)}) }}</p>
        {% else %}
            <table class="table highscore-table">
                <tr class="table-head">
                    <td class="num">{{ 'Platz'|trans }}</td>
                    <td>{{ view == 'players' ? ('Spieler'|trans) : ('Allianz'|trans) }}</td>
                    <td>{{ 'Lebensform'|trans }}</td>
                    {% if view == 'alliances' %}<td class="num">{{ 'Mitglieder'|trans }}</td>{% endif %}
                    <td class="num"><a class="sort-link {{ sort == 'points' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'points'})) }}" title="{{ 'Nach Punkten sortieren'|trans }}">{{ 'Punkte{points}'|trans({'{points}': (sort == 'points' ? ' ▼')}) }}</a></td>
                    <td class="num"><a class="sort-link {{ sort == 'experience' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'experience'})) }}" title="{{ 'Nach Kampferfahrung sortieren'|trans }}">{{ 'Kampferfahrung{experience}'|trans({'{experience}': (sort == 'experience' ? ' ▼')}) }}</a></td>
                    <td class="num"><a class="sort-link {{ sort == 'credits' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'credits'})) }}" title="{{ 'Nach Credits sortieren'|trans }}">{{ 'Credits'|trans }}{{ sort == 'credits' ? ' ▼' }}</a></td>
                    <td class="num"><a class="sort-link {{ sort == 'planets' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'planets'})) }}" title="{{ 'Nach Anzahl Planeten sortieren (verschweißte zählen einzeln)'|trans }}">{{ 'Planeten'|trans }}{{ sort == 'planets' ? ' ▼' }}</a></td>
                </tr>
                {% for r in rows %}
                    {{ _self.row(r, view, own) }}
                {% endfor %}
                {% if own_outside %}
                    <tr class="highscore-gap"><td colspan="{{ view == 'alliances' ? 8 : 7 }}" class="muted">…</td></tr>
                    {{ _self.row(own, view, own) }}
                {% endif %}
            </table>
            {% if total > top %}<p class="muted small">{{ 'Angezeigt werden die besten {top}{Platz}.'|trans({'{top}': top, '{Platz}': own_outside ? (' ' ~ 'und dein Platz'|trans)}) }}</p>{% endif %}
        {% endif %}
        {% if view == 'alliances' %}<p class="muted small">{{ 'Allianzen zählen die Summe ihrer Mitglieder. Der Lebensform-Filter richtet sich nach der Art der Allianz.'|trans }}</p>{% endif %}
    </section>
    <section class="panel">{{ include('_top_experience.html.twig', {top: top_today}) }}</section>
{% endblock %}

{% macro row(r, view, own) %}
    {% import 'game/_macros.html.twig' as ui %}
    <tr class="{{ own and own.rank == r.rank and (view == 'players' ? own.user.id == r.user.id : own.alliance.id == r.alliance.id) ? 'highscore-own' }}">
        <td class="num">{{ r.rank }}.</td>
        {% if view == 'players' %}
            <td>{{ ui.player(r.user) }}</td>
            <td class="small">{{ r.user.lifeForm.icon }} {{ r.user.lifeForm.label|trans }}</td>
        {% else %}
            <td><a href="{{ path('app_alliance_public', {id: r.alliance.id}) }}">{{ r.alliance.name }}</a> <span class="muted">[{{ r.alliance.tag }}]</span></td>
            <td class="small">{{ r.alliance.lifeForm.icon }} {{ r.alliance.lifeForm.label|trans }}</td>
            <td class="num">{{ r.members }}</td>
        {% endif %}
        <td class="num">{{ r.points|num }}</td>
        <td class="num">{{ r.experience|num }}</td>
        <td class="num">{{ r.credits|round(0, 'floor')|num }}</td>
        <td class="num">{{ r.planets|num }}</td>
    </tr>
{% endmacro %}
