{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}Highscores – {{ game_name }}{% endblock %}

{% set params = {view: view, sort: sort, lifeform: life_form ? life_form.value : null}|filter(v => v is not null) %}

{% block content %}
    <h1>Highscores</h1>

    <nav class="tabs" aria-label="Rangliste">
        <a href="{{ path('app_highscores', params|merge({view: 'players'})) }}" class="{{ view == 'players' ? 'active' }}" {{ view == 'players' ? 'aria-current="page"' }}>Spieler</a>
        <a href="{{ path('app_highscores', params|merge({view: 'alliances'})) }}" class="{{ view == 'alliances' ? 'active' }}" {{ view == 'alliances' ? 'aria-current="page"' }}>Allianzen</a>
    </nav>

    <div class="highscore-filters">
        <span class="muted small">Lebensform:</span>
        <a class="filter-chip {{ life_form is null ? 'active' }}" href="{{ path('app_highscores', params|filter((v, k) => k != 'lifeform')) }}">Alle</a>
        {% for lf in enum_cases('App\\Game\\LifeForm') %}
            <a class="filter-chip {{ life_form == lf ? 'active' }}" href="{{ path('app_highscores', params|merge({lifeform: lf.value})) }}">{{ lf.icon }} {{ lf.label }}</a>
        {% endfor %}
        <span class="muted small">{{ total|number_format(0, ',', '.') }} {{ view == 'players' ? 'Spieler' : (total == 1 ? 'Allianz' : 'Allianzen') }}</span>
    </div>

    <section class="panel">
        {% if rows is empty %}
            <p class="muted">{{ view == 'players' ? 'Keine Spieler' : 'Keine Allianzen' }} mit dieser Lebensform.</p>
        {% else %}
            <table class="table highscore-table">
                <tr class="table-head">
                    <td class="num">Platz</td>
                    <td>{{ view == 'players' ? 'Spieler' : 'Allianz' }}</td>
                    {% if view == 'alliances' %}<td class="num">Mitglieder</td>{% endif %}
                    <td class="num"><a class="sort-link {{ sort == 'points' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'points'})) }}" title="Nach Punkten sortieren">Punkte{{ sort == 'points' ? ' ▼' }}</a></td>
                    <td class="num"><a class="sort-link {{ sort == 'experience' ? 'active' }}" href="{{ path('app_highscores', params|merge({sort: 'experience'})) }}" title="Nach Kampferfahrung sortieren">Kampferfahrung{{ sort == 'experience' ? ' ▼' }}</a></td>
                </tr>
                {% for r in rows %}
                    {{ _self.row(r, view, own) }}
                {% endfor %}
                {% if own_outside %}
                    <tr class="highscore-gap"><td colspan="{{ view == 'alliances' ? 5 : 4 }}" class="muted">…</td></tr>
                    {{ _self.row(own, view, own) }}
                {% endif %}
            </table>
            {% if total > top %}<p class="muted small">Angezeigt werden die besten {{ top }}{{ own_outside ? ' und dein Platz' }}.</p>{% endif %}
        {% endif %}
        {% if view == 'alliances' %}<p class="muted small">Allianzen zählen die Summe ihrer Mitglieder. Der Lebensform-Filter richtet sich nach der Art der Allianz.</p>{% endif %}
    </section>
    <section class="panel">{{ include('_top_experience.html.twig', {top: top_today}) }}</section>
{% endblock %}

{% macro row(r, view, own) %}
    {% import 'game/_macros.html.twig' as ui %}
    <tr class="{{ own and own.rank == r.rank and (view == 'players' ? own.user.id == r.user.id : own.alliance.id == r.alliance.id) ? 'highscore-own' }}">
        <td class="num">{{ r.rank }}.</td>
        {% if view == 'players' %}
            <td>{{ ui.player(r.user) }}</td>
        {% else %}
            <td><span title="{{ r.alliance.lifeForm.label }}">{{ r.alliance.lifeForm.icon }}</span> <a href="{{ path('app_alliance_public', {id: r.alliance.id}) }}">{{ r.alliance.name }}</a> <span class="muted">[{{ r.alliance.tag }}]</span></td>
            <td class="num">{{ r.members }}</td>
        {% endif %}
        <td class="num">{{ r.points|number_format(0, ',', '.') }}</td>
        <td class="num">{{ r.experience|number_format(0, ',', '.') }}</td>
    </tr>
{% endmacro %}
