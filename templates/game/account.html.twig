{% extends 'game/_layout.html.twig' %}

{% block title %}{{ 'Konto – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Konto'|trans }}</h1>

    <section class="panel" id="urlaub">
        <h2>{{ '🌴 Urlaubsmodus'|trans }}</h2>
        <p class="muted small">
            {{ 'Im Urlaub ruht alles: keine Produktion, kein Bau, keine Forschung, keine Flotten. Deine Planeten können nicht angegriffen werden – außer invadierten Planeten, die dir noch nicht ganz gehören, und durch Angriffe, die beim Urlaubsbeginn schon unterwegs waren –, ausspioniert werden aber schon. Schreiben, lesen und schauen geht weiter: Post, Ticker, schwarzes Brett, Galaxie, Allianz und Diplomatie. Urlaub dauert {vacation_min} bis {vacation_max} Tage; Kommazahlen sind erlaubt (2,5 Tage = 60 Stunden), so endet er genau zu deiner Wunschzeit. Vorzeitig beenden kannst du ihn frühestens nach einem Tag. Alle Flotten müssen gelandet sein.'|trans({'{vacation_min}': vacation_min|num, '{vacation_max}': vacation_max|num}) }}
        </p>
        <form method="post" action="{{ path('app_account_vacation') }}" class="inline-action">
            <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
            <label>{{ 'Tage'|trans }} <input type="text" name="days" inputmode="decimal" pattern="[0-9]+([.,][0-9]+)?" required class="short" placeholder="z. B. 2,5" data-vacation-days></label>
            <span class="muted small" data-vacation-end></span>
            <button class="btn btn-small" type="submit" id="vacation-start" data-confirm="{{ 'Urlaub jetzt beginnen? Du kannst bis zum Ende nicht spielen (vorzeitig frühestens nach einem Tag).'|trans }}" data-confirm-label="{{ 'Urlaub beginnen'|trans }}">{{ 'Urlaub beginnen'|trans }}</button>
        </form>
    </section>

    <section class="panel" id="email">
        <h2>{{ '✉ E-Mail-Benachrichtigungen'|trans }}</h2>
        <form method="post" action="{{ path('app_account_email') }}" class="mail-form">
            <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
            <label>{{ 'E-Mail-Adresse'|trans }}
                <input type="email" name="email" value="{{ player.email }}" autocomplete="email" placeholder="{{ 'name@example.org'|trans }}">
            </label>
            <p class="small {{ player.emailVerified ? 'muted' : 'warning' }}">
                {% if player.email is null %}{{ 'Noch keine Adresse hinterlegt – ohne Adresse gibt es keine Mails.'|trans }}
                {% elseif player.emailVerified %}{{ '✓ Bestätigt.'|trans }}
                {% else %}{{ 'Noch nicht bestätigt – erst dann kommen Mails.'|trans }} <button class="link-button" type="submit" name="do" value="resend">{{ 'Link erneut senden'|trans }}</button>{% endif %}
            </p>
            <fieldset class="topic-list">
                <legend class="small muted">{{ 'Mails bekomme ich bei:'|trans }}</legend>
                {% for key, label in topics %}
                    <label class="radio"><input type="checkbox" name="topics[]" value="{{ key }}" {{ key in player.mailTopics ? 'checked' }}> {{ label|trans }}</label>
                {% endfor %}
            </fieldset>
            <label class="inline-action">{{ 'Höchstens'|trans }} <input type="number" name="attack_limit" min="0" max="60" value="{{ player.attackMailsPerMinute }}" class="short"> {{ 'Angriffswarnungen pro Minute <span class="muted small">(0 = unbegrenzt)</span>'|trans|raw }}</label>
            <button class="btn btn-small" type="submit" id="email-save">{{ 'Speichern'|trans }}</button>
        </form>
    </section>

    <section class="panel danger-zone" id="loeschen">
        <h2>{{ 'Konto löschen'|trans }}</h2>
        <p class="muted small">{{ '48 Stunden nach dem Antrag ist dein Konto gelöscht. Meldest du dich vorher wieder an, wird die Löschung abgebrochen. Deine Planeten bleiben als <strong>herrenlose Planeten</strong> im Universum – mit allen Rohstoffen, Schiffen und Verteidigungsanlagen. Andere Spieler können sie angreifen und mit Invasionsschiffen übernehmen. Deine Flotten und Handelsstützpunkte bleiben ebenfalls zurück.'|trans|raw }}</p>
        <form method="post" action="{{ path('app_account_delete') }}" class="mail-form">
            <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
            <label class="radio"><input type="radio" name="planets" value="leave" checked> {{ 'Planeten nur verlassen – die Gebäude bleiben stehen'|trans }}</label>
            <label class="radio"><input type="radio" name="planets" value="destroy"> {{ 'Gebäude zerstören – die Planeten bleiben ohne Gebäude zurück'|trans }}</label>
            <label>{{ 'Passwort zur Bestätigung'|trans }} <input type="password" name="password" required autocomplete="current-password"></label>
            <button class="btn btn-danger" type="submit" id="account-delete" data-confirm="{{ 'Konto wirklich löschen? Du wirst abgemeldet; nach 48 Stunden ist das Konto weg. Meldest du dich vorher wieder an, bleibt es erhalten.'|trans }}" data-confirm-label="{{ 'Konto löschen'|trans }}">{{ 'Konto löschen'|trans }}</button>
        </form>
    </section>
{% endblock %}
