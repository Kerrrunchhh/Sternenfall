{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Fusionatoren – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Handel'|trans }}</h1>
    {{ include('game/_trade_tabs.html.twig') }}

    <p class="muted small">{{ 'Händler stellen hier Fusionatoren ein. Gekaufte Fusionatoren fliegen sofort als eigene Flotte zu deinem Hauptplaneten'|trans }}{% if home %} {{ home.name }} {{ ui.coords(home.coordinates) }}{% endif %} {{ '– kostenlos, aber mit der normalen Flugzeit.'|trans }}</p>

    <h2 class="section-title">{{ 'Angebote ({market})'|trans({'{market}': market|length}) }}</h2>
    {% if market is empty %}
        <p class="panel muted">{{ 'Zurzeit bietet dir niemand Fusionatoren an.'|trans }}</p>
    {% else %}
        <div class="panel">
            <table class="table fusionator-market">
                <tr class="table-head"><td>{{ 'Händler'|trans }}</td><td>{{ 'Standort'|trans }}</td><td class="num">{{ 'Anzahl'|trans }}</td><td class="num">{{ 'Preis/Stück'|trans }}</td><td class="num">{{ 'Flugzeit zu dir'|trans }}</td><td>{{ 'Kaufen'|trans }}</td></tr>
                {% for row in market %}
                    {% set o = row.offer %}
                    <tr>
                        <td>{{ ui.player(o.seller) }}{% if o.restricted %}<br><span class="muted small">{{ 'nur für {allowedLifeForms}'|trans({'{allowedLifeForms}': (o.allowedLifeForms|map(l => l.label|trans)|merge(o.allowedAlliances|map(a => '[' ~ a.tag ~ ']')))|join(', ')}) }}</span>{% endif %}</td>
                        <td>{{ ui.coords(o.coordinates) }}</td>
                        <td class="num">{{ o.quantity|num }}</td>
                        <td class="num">{{ '{price} Credits'|trans({'{price}': o.price|num}) }}</td>
                        <td class="num">{{ row.seconds is not null ? row.seconds|format_duration : '–' }}</td>
                        <td>
                            <form method="post" action="{{ path('app_fusionator_buy', {id: o.id}) }}" class="order-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('fusionator_market') }}">
                                <input type="number" name="quantity" min="1" max="{{ o.quantity }}" value="1" aria-label="{{ 'Anzahl Fusionatoren von {username}'|trans({'{username}': o.seller.username}) }}">
                                <button class="btn btn-small" type="submit" id="buy-{{ o.id }}" {% if o.price > player.credits %}disabled title="{{ 'Nicht genug Credits'|trans }}"{% endif %}>{{ 'Kaufen'|trans }}</button>
                                <button class="btn btn-small btn-secondary" type="submit" name="all" value="1" id="buy-all-{{ o.id }}"
                                        {{ o.price * o.quantity > player.credits ? 'disabled' }}
                                        title="{{ 'Alle {quantity} für {value} Credits'|trans({'{quantity}': o.quantity, '{value}': (o.price * o.quantity)|num}) }}">{{ 'Alle ({value} Cr)'|trans({'{value}': (o.price * o.quantity)|num}) }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endif %}

    {% if is_trader or mine is not empty %}
        <h2 class="section-title">{{ 'Deine Angebote ({mine})'|trans({'{mine}': mine|length}) }}</h2>
        {% if mine is empty %}
            <p class="panel muted">{{ 'Du hast keine Fusionatoren eingestellt.'|trans }}</p>
        {% else %}
            <div class="panel">
                <table class="table">
                    {% for o in mine %}
                        <tr>
                            <td>{{ '{quantity} × Fusionator bei {coordinates}'|trans({'{quantity}': o.quantity|num|e, '{coordinates}': ui.coords(o.coordinates)})|raw }}</td>
                            <td class="num">{{ '{price} Credits/Stück'|trans({'{price}': o.price|num}) }}</td>
                            <td class="muted small">{% if o.restricted %}{{ 'nur für {allowedLifeForms}'|trans({'{allowedLifeForms}': (o.allowedLifeForms|map(l => l.label|trans)|merge(o.allowedAlliances|map(a => '[' ~ a.tag ~ ']')))|join(', ')}) }}{% else %}{{ 'für alle'|trans }}{% endif %}</td>
                            <td class="num">
                                <form method="post" action="{{ path('app_fusionator_withdraw', {id: o.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('fusionator_market') }}">
                                    <button class="btn btn-small btn-danger" type="submit" id="withdraw-{{ o.id }}" data-confirm="{{ 'Angebot zurückziehen? Die Fusionatoren kommen zurück in den Hangar.'|trans }}" data-confirm-label="{{ 'Zurückziehen'|trans }}">{{ 'Zurückziehen'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        {% endif %}
    {% endif %}

    {% if is_trader %}
        <section class="panel">
            <h2>{{ 'Fusionatoren einstellen'|trans }}</h2>
            {% if in_hangar == 0 %}
                <p class="muted">{{ 'Im Hangar von {name} stehen keine Fusionatoren. Baue welche in der'|trans({'{name}': planet.name}) }} <a href="{{ path('app_shipyard') }}">{{ 'Werft</a> oder wechsle den Planeten.'|trans|raw }}</p>
            {% else %}
                <form method="post" action="{{ path('app_fusionator_offer') }}" class="fleet-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('fusionator_market') }}">
                    <p class="muted small">{{ 'Aus dem Hangar von {name} {coordinates} – dort stehen {in_hangar} Fusionator(en).'|trans({'{name}': planet.name|e, '{coordinates}': ui.coords(planet.coordinates), '{in_hangar}': in_hangar|num|e})|raw }}</p>
                    <label>{{ 'Anzahl'|trans }} <input type="number" name="quantity" min="1" max="{{ in_hangar }}" value="{{ in_hangar }}" required></label>
                    <label>{{ 'Preis pro Stück (Credits)'|trans }} <input type="text" name="price" inputmode="decimal" required placeholder="z. B. 250000"></label>
                    <fieldset>
                        <legend>{{ 'Wer darf kaufen? <span class="muted small">(nichts angekreuzt: alle)</span>'|trans|raw }}</legend>
                        {% for lf in life_forms %}
                            <label><input type="checkbox" name="life_forms[]" value="{{ lf.value }}"> {{ lf.icon }} {{ lf.label|trans }}</label>
                        {% endfor %}
                        {% for a in alliances %}
                            <label><input type="checkbox" name="alliances[]" value="{{ a.id }}"> [{{ a.tag }}] {{ a.name }}</label>
                        {% endfor %}
                    </fieldset>
                    <button class="btn" type="submit" id="fusionator-offer">{{ 'Einstellen'|trans }}</button>
                </form>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
