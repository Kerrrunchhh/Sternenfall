{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Transportgesuche – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Transportgesuche'|trans }}</h1>
    <p class="muted small">{{ 'Dir fehlen Rohstoffe? Stelle ein Gesuch über höchstens eine Frachterladung ({max_load} Rohstoffe). Der Preis ist fest: 1 Credit je {per} Rohstoffe. Händler liefern; bezahlt wird erst, wenn die Ladung ankommt – bis dahin sind deine Credits verwahrt.'|trans({'{max_load}': max_load|num, '{per}': resources_per_credit|num}) }}</p>

    {% if is_trader %}
        <section class="panel">
            <h2>{{ 'Gesuche beliefern'|trans }}</h2>
            <p class="muted small">{{ 'Geliefert wird von <strong>{name}</strong> {coordinates}: je Gesuch eine leere, dort wartende Flotte nur aus Frachtern. Stationiere dafür viele kleine Handelsflotten an diesem Planeten. Bereit: <strong>{ready_fleets}</strong> {ready_fleets2}.'|trans({'{name}': planet.name|e, '{coordinates}': ui.coords(planet.coordinates), '{ready_fleets}': ready_fleets|length|e, '{ready_fleets2}': (ready_fleets|length == 1 ? ('Flotte'|trans) : ('Flotten'|trans))|e})|raw }}</p>
            {% if open is empty %}
                <p class="muted">{{ 'Gerade sucht niemand Rohstoffe.'|trans }}</p>
            {% else %}
                <form method="post" action="{{ path('app_transport_request_serve') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('transport_requests') }}">
                    <table class="table">
                        <thead><tr><th><input type="checkbox" data-check-all="requests[]" aria-label="{{ 'Alle auswählen'|trans }}"></th><th>{{ 'Ziel'|trans }}</th><th>{{ 'Ware'|trans }}</th><th>{{ 'Preis'|trans }}</th><th>{{ 'Von'|trans }}</th></tr></thead>
                        <tbody>
                        {% for r in open %}
                            <tr>
                                <td><input type="checkbox" name="requests[]" value="{{ r.id }}" aria-label="{{ 'Gesuch {planetName}'|trans({'{planetName}': r.planetName}) }}"></td>
                                <td>{{ r.planetName }} {{ ui.coords(r.coordinates) }}</td>
                                <td class="small">{% for type in resource_types %}{% set n = r.goods.get(type) %}{% if n > 0 %}{{ type.label|trans }} {{ n|num }}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</td>
                                <td>{{ '<strong>{offer}</strong> Cr'|trans({'{offer}': r.offer|num|e})|raw }}</td>
                                <td>{{ ui.player(r.requester) }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <button class="btn" type="submit" id="serve-requests">{{ 'Ausgewählte beliefern'|trans }}</button>
                </form>
            {% endif %}
        </section>
    {% else %}
        <section class="panel">
            <h2>{{ 'Offene Gesuche'|trans }}</h2>
            {% if open is empty %}
                <p class="muted">{{ 'Keine.'|trans }}</p>
            {% else %}
                {% for r in open %}
                    <div class="proposal"><div>{{ '{planetName} {coordinates} · {total} Rohstoffe für <strong>{offer} Credits</strong> · {requester}'|trans({'{planetName}': r.planetName|e, '{coordinates}': ui.coords(r.coordinates), '{total}': r.goods.total|num|e, '{offer}': r.offer|num|e, '{requester}': ui.player(r.requester)})|raw }}</div></div>
                {% endfor %}
                <p class="muted small">{{ 'Beliefern können nur Händler.'|trans }}</p>
            {% endif %}
        </section>
    {% endif %}

    <section class="panel">
        <h2>{{ 'Deine Gesuche und Lieferungen'|trans }}</h2>
        {% if mine is empty %}
            <p class="muted">{{ 'Noch keine.'|trans }}</p>
        {% else %}
            {% for r in mine %}
                <div class="proposal">
                    <div>
                        {{ '{planetName} {coordinates} · {total} Rohstoffe · {offer} Credits'|trans({'{planetName}': r.planetName|e, '{coordinates}': ui.coords(r.coordinates), '{total}': r.goods.total|num|e, '{offer}': r.offer|num|e})|raw }}
                        <div class="muted small">
                            {{ {open: 'offen', assigned: ('wird geliefert'|trans), done: 'geliefert', cancelled: ('zurückgezogen'|trans)}[r.status] }}
                            {% if r.requester.id == player.id %}{% if r.trader %} {{ '· Händler {trader}'|trans({'{trader}': ui.player(r.trader)})|raw }}{% endif %}{% else %} {{ '· du lieferst an {requester}'|trans({'{requester}': ui.player(r.requester)})|raw }}{% endif %}
                            · {{ r.createdAt|date('d.m.Y H:i') }}
                        </div>
                    </div>
                    {% if r.requester.id == player.id and r.status == 'open' %}
                        <form method="post" action="{{ path('app_transport_request_cancel', {id: r.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('transport_requests') }}">
                            <button class="btn btn-small btn-secondary" type="submit">{{ 'Zurückziehen'|trans }}</button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
    </section>

    <section class="panel">
        <h2>{{ 'Neues Gesuch'|trans }} <small class="muted">{{ '{active} von {max} laufen'|trans({'{active}': active_requests, '{max}': max_active}) }}</small></h2>
        {% if active_requests >= max_active %}
            <p class="muted">{{ 'Du hast schon {max} Transportgesuche laufen. Ein neues geht erst, wenn eines geliefert oder zurückgezogen ist.'|trans({'{max}': max_active}) }}</p>
        {% else %}
        <form method="post" action="{{ path('app_transport_request_create') }}" class="mail-form" data-transport-offer data-resources-per-credit="{{ resources_per_credit }}">
            <input type="hidden" name="_token" value="{{ csrf_token('transport_requests') }}">
            <label>{{ 'Lieferung an'|trans }}
                <select name="planet">
                    {% for p in player.planets %}<option value="{{ p.id }}" {{ p.id == planet.id ? 'selected' }}>{{ p.name }} [{{ p.coordinates }}]</option>{% endfor %}
                </select>
            </label>
            <div class="coords">
                {% for type in resource_types %}
                    <label>{{ type.label|trans }} <input type="number" name="goods[{{ type.value }}]" min="0" max="{{ max_load }}" value="0" data-goods></label>
                {% endfor %}
            </div>
            <p class="muted small">{{ 'Summe: <span data-goods-total>0</span> von {max_load} · Preis: <strong><span data-offer-hint>0</span> Credits</strong>'|trans({'{max_load}': max_load|num|e})|raw }}</p>
            <button class="btn" type="submit" id="transport-request-create">{{ 'Gesuch einstellen'|trans }}</button>
        </form>
        {% endif %}
    </section>
{% endblock %}
