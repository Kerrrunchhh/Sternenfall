{% extends 'game/_layout.html.twig' %}

{% block title %}{{ 'Allianz – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Allianz'|trans }}</h1>
    <p class="muted">{{ 'Du bist in keiner Allianz. Typ einer Gründung von dir ({label}): <strong>{allianceType}</strong>. Mitglieder können jede Lebensform haben.'|trans({'{label}': player.lifeForm.label|trans|e, '{allianceType}': player.lifeForm.allianceType|e})|raw }}</p>

    {% if invitations is not empty %}
        <section class="panel construction">
            <div style="flex: 1">
                <h2>{{ 'Einladungen'|trans }}</h2>
                {% for inv in invitations %}
                    <div class="inline-action">
                        <span>{{ inv.alliance.type|trans }} <strong>{{ inv.alliance.name }}</strong> [{{ inv.alliance.tag }}]</span>
                        <form method="post" action="{{ path('app_alliance_answer', {id: inv.id, answer: 'accept'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('alliance') }}">
                            <button class="btn btn-small" type="submit">{{ 'Annehmen'|trans }}</button>
                        </form>
                        <form method="post" action="{{ path('app_alliance_answer', {id: inv.id, answer: 'decline'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('alliance') }}">
                            <button class="btn btn-small btn-secondary" type="submit">{{ 'Ablehnen'|trans }}</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <div class="grid">
        <section class="panel">
            <h2>{{ '{allianceType} gründen'|trans({'{allianceType}': player.lifeForm.allianceType}) }}</h2>
            <form method="post" action="{{ path('app_alliance_found') }}" class="fleet-form">
                <input type="hidden" name="_token" value="{{ csrf_token('alliance') }}">
                <label>{{ 'Name'|trans }} <input type="text" name="name" minlength="3" maxlength="40" required></label>
                <label>{{ 'Kürzel (2–6 Zeichen)'|trans }} <input type="text" name="tag" minlength="2" maxlength="6" required pattern="[A-Za-z0-9]{2,6}"></label>
                <button class="btn btn-small" type="submit" id="alliance-found">{{ 'Gründen'|trans }}</button>
            </form>
        </section>
        <section class="panel">
            <h2>{{ 'Bestehende Allianzen'|trans }}</h2>
            {% if alliances is empty %}
                <p class="muted">{{ 'Es gibt noch keine.'|trans }}</p>
            {% else %}
                <table class="table">
                    {% for a in alliances %}
                        <tr>
                            <td><a href="{{ path('app_alliance_public', {id: a.id}) }}"><strong>{{ a.name }}</strong> [{{ a.tag }}]</a><br><span class="muted small">{{ (a.members|length == 1 ? '{type} · {count} Mitglied' : '{type} · {count} Mitglieder')|trans({'{type}': a.type|trans, '{count}': a.members|length}) }}</span></td>
                            <td class="num">
                                <form method="post" action="{{ path('app_alliance_apply', {id: a.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('alliance') }}">
                                    <button class="btn btn-small btn-secondary" type="submit">{{ 'Bewerben'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% endif %}
        </section>
    </div>
{% endblock %}
