{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Spielerprotokoll – Admin – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ '🛡 Spielerprotokoll'|trans }}</h1>
    <p class="muted small">{{ 'Flottenbefehle, Lieferungen, Handel, Zahlungen und Kämpfe der letzten {days} Tage – für den Verdacht auf Cheating. Jede Einsicht wird selbst protokolliert.'|trans({'{days}': keep_days}) }}</p>
    <form method="get" action="{{ path('app_admin_action_log') }}" class="panel inline-action admin-user-search">
        <input type="text" name="player" value="{{ query.player }}" required placeholder="{{ 'Spieler'|trans }}" aria-label="{{ 'Spieler'|trans }}">
        <input type="text" name="with" value="{{ query.with }}" placeholder="{{ 'nur mit Spieler (optional)'|trans }}" aria-label="{{ 'nur mit Spieler'|trans }}">
        <select name="kind" aria-label="{{ 'Art'|trans }}">
            <option value="">{{ 'Alle Arten'|trans }}</option>
            {% for key, label in kinds %}<option value="{{ key }}" {{ kind == key ? 'selected' }}>{{ label|trans }}</option>{% endfor %}
        </select>
        <button class="btn btn-small" type="submit" id="action-log-search">{{ 'Anzeigen'|trans }}</button>
    </form>

    {% if subject %}
        <section class="panel">
            <h2>{{ subject.username }}{% if with %} ↔ {{ with.username }}{% endif %} <small class="muted">{{ (entries|length == 1 ? '1 Eintrag' : '{count} Einträge')|trans({'{count}': entries|length}) }}</small></h2>
            {% if entries is empty %}
                <p class="muted">{{ 'Keine Einträge.'|trans }}</p>
            {% else %}
                <div class="table-scroll">
                    <table class="table action-log">
                        <thead><tr><th>{{ 'Zeit'|trans }}</th><th>{{ 'Art'|trans }}</th><th>{{ 'Spieler'|trans }}</th><th>{{ 'betrifft'|trans }}</th><th>{{ 'Was'|trans }}</th></tr></thead>
                        <tbody>
                            {% for e in entries %}
                                <tr>
                                    <td class="small nowrap">{{ e.createdAt|date('d.m. H:i:s') }}</td>
                                    <td class="small">{{ kinds[e.kind]|default(e.kind)|trans }}</td>
                                    <td>{{ ui.player(e.actor) }}</td>
                                    <td>{% if e.other %}<a href="{{ path('app_admin_action_log', {player: subject.username, with: e.other.id == subject.id ? e.actor.username : e.other.username}) }}" title="{{ 'Nur Einträge zwischen diesen beiden'|trans }}">{{ e.other.username }}</a>{% else %}<span class="muted">–</span>{% endif %}</td>
                                    <td class="small">{{ e.text }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
        {% if logins is not empty %}
            <section class="panel">
                <h2>{{ 'Anmeldungen'|trans }} <small class="muted">{{ logins|length }}</small></h2>
                <div class="table-scroll">
                    <table class="table">
                        <thead><tr><th>{{ 'Zeit'|trans }}</th><th>{{ 'IP'|trans }}</th><th>{{ 'Gerät'|trans }}</th><th>{{ 'Browser'|trans }}</th></tr></thead>
                        <tbody>
                            {% for l in logins %}
                                <tr><td class="small nowrap">{{ l.createdAt|date('d.m. H:i') }}</td><td class="small">{{ l.ip }}</td><td class="small">{{ l.fingerprint ? l.fingerprint|slice(0, 10) : '–' }}</td><td class="small muted">{{ l.userAgent|slice(0, 90) }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
