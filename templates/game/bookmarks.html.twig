{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Koordinaten – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Gemerkte Koordinaten <small class="muted">{bookmarks} / {max_bookmarks}</small>'|trans({'{bookmarks}': bookmarks|length|e, '{max_bookmarks}': max_bookmarks|e})|raw }}</h1>
    <p class="muted small">{{ 'Merke dir Koordinaten im'|trans }} <a href="{{ path('app_galaxy') }}">{{ 'Universum</a> mit 📌. Beim Losschicken einer Flotte kannst du sie dann aus der Liste „Gemerkte Koordinaten“ wählen.'|trans|raw }}</p>

    {% if bookmarks is empty %}
        <p class="panel muted">{{ 'Noch keine Koordinaten gemerkt.'|trans }}</p>
    {% else %}
        <p class="muted small">{{ 'Die Reihenfolge gilt auch für die Auswahl beim Losschicken einer Flotte. Hake Koordinaten an und verschiebe sie mit den Knöpfen unten – oder ziehe sie am Griff ⠿ an ihren Platz.'|trans }}</p>
        <form id="bookmark-move" method="post" action="{{ path('app_bookmark_move') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bookmark') }}">
        </form>
        <div class="panel">
            <table class="table bookmarks">
                <tbody data-bookmark-sort data-url="{{ path('app_bookmark_order') }}" data-token="{{ csrf_token('bookmark') }}">
                {% for b in bookmarks %}
                    <tr id="bookmark-{{ b.id }}" data-bookmark-id="{{ b.id }}">
                        <td class="bookmark-pick-cell">
                            <button type="button" class="drag-handle" data-drag-handle hidden title="{{ 'Ziehen zum Verschieben'|trans }}" aria-label="{{ '{label} verschieben'|trans({'{label}': b.label|trans}) }}">⠿</button>
                            <input type="checkbox" form="bookmark-move" name="ids[]" value="{{ b.id }}" id="bookmark-check-{{ b.id }}"{{ selected[b.id] is defined ? ' checked' }} aria-label="{{ '{label} auswählen'|trans({'{label}': b.label|trans}) }}">
                        </td>
                        <td class="num">{{ ui.coords(b.coordinates) }}</td>
                        <td>
                            <form method="post" action="{{ path('app_bookmark_rename', {id: b.id}) }}" class="inline-action">
                                <input type="hidden" name="_token" value="{{ csrf_token('bookmark') }}">
                                <input type="text" name="label" value="{{ b.label|trans }}" maxlength="40" required aria-label="{{ 'Name für {coordinates}'|trans({'{coordinates}': b.coordinates}) }}">
                                <button class="btn btn-small btn-secondary" type="submit" id="bookmark-rename-{{ b.id }}">{{ 'Speichern'|trans }}</button>
                            </form>
                        </td>
                        <td class="num actions">
                            <a href="{{ path('app_fleet', {galaxy: b.galaxy, system: b.system, position: b.position}) }}">{{ 'Flotte hierhin'|trans }}</a>
                            <form method="post" action="{{ path('app_bookmark_delete', {id: b.id}) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('bookmark') }}">
                                <button class="btn btn-small btn-danger" type="submit" id="bookmark-delete-{{ b.id }}" aria-label="{{ '{label} vergessen'|trans({'{label}': b.label|trans}) }}">✕</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% if bookmarks|length > 1 %}
                <div class="bookmark-tools" role="group" aria-label="{{ 'Ausgewählte Koordinaten verschieben'|trans }}">
                    <button class="btn btn-small" type="submit" form="bookmark-move" name="move" value="top" id="bookmark-move-top">⤒ {{ 'Ganz nach oben'|trans }}</button>
                    <button class="btn btn-small" type="submit" form="bookmark-move" name="move" value="up" id="bookmark-move-up">↑ {{ 'Nach oben'|trans }}</button>
                    <button class="btn btn-small" type="submit" form="bookmark-move" name="move" value="down" id="bookmark-move-down">↓ {{ 'Nach unten'|trans }}</button>
                    <button class="btn btn-small" type="submit" form="bookmark-move" name="move" value="bottom" id="bookmark-move-bottom">⤓ {{ 'Ganz nach unten'|trans }}</button>
                    <a class="btn btn-small btn-secondary" href="{{ path('app_bookmarks') }}" data-bookmark-clear>{{ 'Auswahl aufheben'|trans }}</a>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
