{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}Handel – {{ game_name }}{% endblock %}

{% block content %}
    <h1>Handel</h1>
    {{ include('game/_trade_tabs.html.twig') }}

    <section class="panel">
        <h2>Durchschnittspreise</h2>
        <p class="muted small">Durchschnitt über alle Handelsstützpunkte, die die Ware zu einem Preis anbieten und vorrätig haben (Credits pro Stück).</p>
        <table class="table">
            <tr class="table-head"><td>Ware</td><td class="num">Ø Preis</td><td class="num">Angebote</td></tr>
            {% for good in goods %}
                <tr>
                    <td>{{ good|good_label }}</td>
                    {% if averages[good] is defined %}
                        <td class="num">{{ averages[good].average|number_format(2, ',', '.') }}</td>
                        <td class="num">{{ averages[good].posts }}</td>
                    {% else %}
                        <td class="num muted">–</td><td class="num muted">0</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </table>
    </section>

    <h2 class="section-title">Alle Handelsstützpunkte ({{ posts|filter(p => p.active)|length }})</h2>
    {% for post in posts|filter(p => p.active or p.owner.id == player.id) %}
        {% set access = post.accessibleTo(player) %}
        <article class="panel trade-card {{ access ? '' : 'locked' }}">
            <div class="building-head">
                <h2>{{ post.name }} <small class="muted">[{{ post.coordinates }}] · {{ ui.player(post.owner) }}</small></h2>
                <span class="small {{ access ? '' : 'negative' }}">
                    {% if not post.active %}aufgegeben – nur noch Ware abholen
                    {% elseif not post.restricted %}offen für alle
                    {% else %}nur für {{ (post.allowedLifeForms|map(l => l.label)|merge(post.allowedAlliances|map(a => '[' ~ a.tag ~ ']')))|join(', ') }}{% endif %}
                    {{ access ? '' : '· für dich gesperrt' }}
                </span>
            </div>
            <table class="table">
                <tr class="table-head"><td>Ware</td><td class="num">Preis</td><td class="num">Lager</td></tr>
                {% for good in goods %}
                    {% if post.price(good) > 0 or post.stock(good) > 0 %}
                        <tr>
                            <td>{{ good|good_label }}</td>
                            <td class="num">{{ post.price(good) > 0 ? post.price(good)|number_format(2, ',', '.') : 'nicht im Verkauf' }}</td>
                            <td class="num">{{ post.stock(good)|number_format(0, ',', '.') }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </table>
            {% if access %}
                <a class="btn btn-small" href="{{ path('app_fleet', {galaxy: post.galaxy, system: post.system, position: post.position, mission: post.owner.id == player.id and post.active ? 'supply' : 'trade'}) }}">
                    {{ post.owner.id != player.id ? 'Flotte zum Handeln schicken' : (post.active ? 'Flotte zum Beliefern schicken' : 'Flotte zum Abholen schicken') }}
                </a>
            {% endif %}
        </article>
    {% else %}
        <p class="panel muted">Noch gibt es keine Handelsstützpunkte.</p>
    {% endfor %}

    {% if is_trader %}
        <h2 class="section-title">Deine Handelsstützpunkte ({{ mine|filter(p => p.active)|length }} / {{ allowed_posts }})</h2>
        {% for post in mine|filter(p => p.active) %}
            <article class="panel">
                <form method="post" action="{{ path('app_trade_configure', {id: post.id}) }}" class="fleet-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                    <label>Name <input type="text" name="name" value="{{ post.name }}" maxlength="40" required></label>
                    <h3>Verkaufspreise (Credits pro Stück, 0 = nicht im Verkauf)</h3>
                    <div class="coords">
                        {% for good in goods %}
                            <label>{{ good|good_label }} <input type="number" name="prices[{{ good }}]" min="0" step="0.01" value="{{ post.price(good) }}"></label>
                        {% endfor %}
                    </div>
                    <h3>Zugang (nichts angehakt = offen für alle)</h3>
                    <div class="type-checks">
                        {% for lf in life_forms %}
                            <label><input type="checkbox" name="life_forms[]" value="{{ lf.value }}" {{ lf in post.allowedLifeForms ? 'checked' }}> {{ lf.label }}</label>
                        {% endfor %}
                        {% for a in alliances %}
                            <label><input type="checkbox" name="alliances[]" value="{{ a.id }}" {{ post.allowedAlliances.contains(a) ? 'checked' }}> [{{ a.tag }}] {{ a.name }}</label>
                        {% endfor %}
                    </div>
                    <button class="btn btn-small" type="submit" id="trade-{{ post.id }}-save">Speichern</button>
                </form>
                <h3>Fremde Flotten an diesem Stützpunkt</h3>
                {% if visitors[post.id] is defined %}
                    <table class="table">
                        {% for v in visitors[post.id] %}
                            <tr>
                                <td>
                                    {{ v.fleet.label }} <span class="muted small">von {{ ui.player(v.fleet.owner) }}</span><br>
                                    <span class="small">{% for s in v.fleet.shipList %}{{ s.count|number_format(0, ',', '.') }} × {{ s.type.label }}{{ not loop.last ? ', ' }}{% endfor %}</span>
                                </td>
                                <td class="num small">
                                    {% if v.plan %}
                                        nach {{ v.plan.home.name }} [{{ v.plan.home.coordinates }}], {{ v.plan.seconds|format_duration }}<br>
                                        aus dem Lager: {{ v.plan.cost.hydrogen|number_format(0, ',', '.') }} Wasserstoff, {{ v.plan.cost.food|number_format(0, ',', '.') }} Nahrung, {{ v.plan.cost.water|number_format(0, ',', '.') }} Wasser
                                    {% endif %}
                                </td>
                                <td class="num">
                                    <form method="post" action="{{ path('app_trade_send_away', {id: post.id, fleet: v.fleet.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                                        <button class="btn btn-small btn-danger" type="submit" id="send-away-{{ v.fleet.id }}">Zurückschicken</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                {% else %}
                    <p class="muted small">Keine.</p>
                {% endif %}
                <form method="post" action="{{ path('app_trade_close', {id: post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                    <button class="btn btn-small btn-danger" type="submit" data-confirm="Stützpunkt schließen? Das geht nur, wenn das Lager leer ist." data-confirm-label="Schließen">Schließen</button>
                </form>
            </article>
        {% endfor %}
        {% if mine|filter(p => p.active)|length < allowed_posts %}
            <section class="panel">
                <h2>Neuen Stützpunkt eröffnen</h2>
                <form method="post" action="{{ path('app_trade_open') }}" class="fleet-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                    <label>Name <input type="text" name="name" maxlength="40" required></label>
                    <div class="coords">
                        <label>Galaxie <input type="number" name="galaxy" min="1" value="{{ planet.galaxy }}" required></label>
                        <label>System <input type="number" name="system" min="1" value="{{ planet.system }}" required></label>
                        <label>Position <input type="number" name="position" min="1" required></label>
                    </div>
                    <p class="muted small">Nur auf einem freien Platz. Der Platz kann dann nicht mehr kolonisiert werden.</p>
                    <button class="btn btn-small" type="submit" id="trade-open">Eröffnen</button>
                </form>
            </section>
        {% else %}
            <p class="muted">{{ allowed_posts == 0 ? 'Erforsche „Handelsnetz“, um Handelsstützpunkte zu eröffnen.' : 'Für weitere Stützpunkte brauchst du eine höhere Stufe „Handelsnetz“.' }}</p>
        {% endif %}
    {% endif %}
{% endblock %}
