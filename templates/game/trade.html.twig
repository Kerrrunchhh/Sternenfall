{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Handel – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Handel'|trans }}</h1>
    {{ include('game/_trade_tabs.html.twig') }}

    {% if guild_post %}
        <section class="panel guild-panel">
            <img class="guild-banner" src="{{ asset('pictures/guild/exchange' ~ (app.request.locale == 'en' ? '-en') ~ '.webp') }}" alt="{{ 'Zentralbörse der Handelsgilde'|trans }}" width="960" height="524" loading="lazy">
            <h2>{{ '🏛 Handelsgilde – {name} {coordinates}'|trans({'{name}': guild_post.name|e, '{coordinates}': ui.coords(guild_post.coordinates)})|raw }}</h2>
            <p class="small">{{ 'Die Handelsgilde hat in der Mitte jeder Galaxie (System {system}) eine Zentralbörse. Sie kauft und verkauft jeden Rohstoff zu festen Preisen – etwas schlechter als bei Händlern, dafür immer und in jeder Menge. Schick eine benannte Flotte aus Frachtern mit dem Auftrag „Handeln“ hin (leer zum Einkaufen oder mit Rohstoffen zum Verkaufen); dort wartet sie, und du handelst auf der Seite der Börse. Die Zentralbörsen können nicht angegriffen werden – Handelsstützpunkte von Spielern schon.'|trans({'{system}': guild_post.system}) }}</p>
            <table class="table">
                <thead><tr><th>{{ 'Rohstoff'|trans }}</th><th class="num">{{ 'Gilde verkauft für'|trans }}</th><th class="num">{{ 'Gilde kauft für'|trans }}</th></tr></thead>
                <tbody>
                    {% for good in goods %}
                        <tr><td>{{ good|good_label|trans }}</td><td class="num">{{ guild_sell[good]|num(2) }}</td><td class="num">{{ guild_buy[good]|num(2) }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="muted small">{{ 'Außerdem verkauft die Gilde Fusionatoren für {price} Credits das Stück (Fusionator-Markt, sie fliegen von Galaxie {galaxy} zu dir) und liefert Transportgesuche, die nach 2 Stunden noch kein Händler angenommen hat – von der Zentralbörse deiner Galaxie, höchstens 4 Stunden Flug.'|trans({'{price}': guild_fusionator_price|num, '{galaxy}': guild_fusionator_galaxy}) }}</p>
            <p><a class="btn btn-small" href="{{ path('app_fleet', {galaxy: guild_post.galaxy, system: guild_post.system, position: guild_post.position, mission: 'trade'}) }}">{{ 'Flotte zur Zentralbörse schicken'|trans }}</a></p>
        </section>
    {% endif %}

    <section class="panel">
        <h2>{{ 'Durchschnittspreise'|trans }}</h2>
        <p class="muted small">{{ 'Durchschnitt über alle Handelsstützpunkte, die die Ware zu einem Preis anbieten und vorrätig haben (Credits pro Stück).'|trans }}</p>
        <table class="table">
            <tr class="table-head"><td>{{ 'Ware'|trans }}</td><td class="num">{{ 'Ø Preis'|trans }}</td><td class="num">{{ 'Angebote'|trans }}</td></tr>
            {% for good in goods %}
                <tr>
                    <td>{{ good|good_label|trans }}</td>
                    {% if averages[good] is defined %}
                        <td class="num">{{ averages[good].average|num(2) }}</td>
                        <td class="num">{{ averages[good].posts }}</td>
                    {% else %}
                        <td class="num muted">–</td><td class="num muted">0</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </table>
    </section>

    <h2 class="section-title">{{ 'Alle Handelsstützpunkte ({posts})'|trans({'{posts}': posts|filter(p => p.active)|length}) }}
        <label class="inline-check small"><input type="checkbox" data-only-accessible> {{ 'nur für mich zugängliche'|trans }}</label></h2>
    {% set listed = posts|filter(p => p.active or p.owner.id == player.id) %}
    {% if listed is empty %}
        <p class="panel muted">{{ 'Noch gibt es keine Handelsstützpunkte.'|trans }}</p>
    {% else %}
        <div class="panel">
            <table class="table">
                {% for post in listed %}
                    {% set access = post.accessibleTo(player) %}
                    <tr class="{{ access ? '' : 'muted' }}" data-post-row data-accessible="{{ access and post.active ? 1 : 0 }}">
                        <td><a href="{{ path('app_trade_post', {id: post.id}) }}">⚖ {{ post.name }}</a></td>
                        <td>{{ ui.coords(post.coordinates) }}</td>
                        <td>{{ ui.player(post.owner) }}</td>
                        <td class="small">
                            {% if not post.active %}{{ 'aufgegeben'|trans }}
                            {% elseif not post.restricted %}{{ 'offen für alle'|trans }}
                            {% else %}{{ 'nur für {allowedLifeForms}'|trans({'{allowedLifeForms}': (post.allowedLifeForms|map(l => l.label|trans)|merge(post.allowedAlliances|map(a => '[' ~ a.tag ~ ']')))|join(', ')}) }}{% endif %}
                            {{ access ? '' : '· ' ~ 'gesperrt'|trans }}
                            {% if post.buysAnything %}{{ '· kauft an'|trans }}{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endif %}

    {% if is_trader %}
        <h2 class="section-title">{{ 'Deine Handelsstützpunkte ({mine} / {allowed_posts})'|trans({'{mine}': mine|filter(p => p.active)|length, '{allowed_posts}': allowed_posts}) }}</h2>
        {% if mine|filter(p => p.active) is not empty %}
            <div class="panel">
                <table class="table">
                    {% for post in mine|filter(p => p.active) %}
                        <tr>
                            <td>⚖ {{ post.name }} {{ ui.coords(post.coordinates) }}</td>
                            <td class="small muted">{{ visitors[post.id] is defined ? visitors[post.id]|length ~ (' ' ~ 'fremde Flotte(n) warten'|trans) : '' }}</td>
                            <td class="num"><a class="btn btn-small" href="{{ path('app_trade_post', {id: post.id}) }}">{{ 'Verwalten'|trans }}</a></td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        {% endif %}
        {% if mine|filter(p => p.active)|length < allowed_posts %}
            <section class="panel">
                <h2>{{ 'Neuen Stützpunkt eröffnen'|trans }}</h2>
                <form method="post" action="{{ path('app_trade_open') }}" class="fleet-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                    <label>{{ 'Name'|trans }} <input type="text" name="name" maxlength="40" required></label>
                    {% set post_slots = mine|map(p => p.coordinates) %}
                    {% set colonies = player.planets|filter(p => not p.homeworld and p.coordinates not in post_slots) %}
                    {% if colonies is empty %}
                        <p class="muted small">{{ 'Ein Handelsstützpunkt steht auf einer deiner Kolonien (nicht auf dem Heimatplaneten). Gründe zuerst eine Kolonie.'|trans }}</p>
                    {% else %}
                        <label>{{ 'Auf Kolonie'|trans }}
                            <select name="planet">
                                {% for p in colonies %}<option value="{{ p.id }}" {{ p.id == planet.id ? 'selected' }}>{{ p.name }} [{{ p.coordinates }}]</option>{% endfor %}
                            </select>
                        </label>
                    {% endif %}
                    <p class="muted small">{{ 'Der Stützpunkt handelt mit den Rohstoffen dieses Planeten. Der Planet bleibt ganz normal ausbaubar – und kann wie jeder Planet angegriffen und erobert werden; dann ist der Stützpunkt weg.'|trans }}</p>
                    <button class="btn btn-small" type="submit" id="trade-open">{{ 'Eröffnen'|trans }}</button>
                </form>
            </section>
        {% else %}
            <p class="muted">{{ allowed_posts == 0 ? ('Erforsche „Handelsnetz“, um Handelsstützpunkte zu eröffnen.'|trans) : ('Für weitere Stützpunkte brauchst du eine höhere Stufe „Handelsnetz“.'|trans) }}</p>
        {% endif %}
    {% endif %}
{% endblock %}
