{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ post.name }} – {{ game_name }}{% endblock %}

{% block content %}
    <h1>⚖ {{ post.name }} <small>{{ ui.coords(post.coordinates) }}</small></h1>
    <p class="muted">
        {{ 'Handelsstützpunkt von {owner} ·'|trans({'{owner}': ui.player(post.owner)})|raw }}
        {% if not post.active %}{{ 'aufgegeben – nur der Besitzer kann die Ware noch abholen'|trans }}
        {% elseif not post.restricted %}{{ 'offen für alle'|trans }}
        {% else %}{{ 'nur für {allowedLifeForms}'|trans({'{allowedLifeForms}': (post.allowedLifeForms|map(l => l.label|trans)|merge(post.allowedAlliances|map(a => '[' ~ a.tag ~ ']')))|join(', ')}) }}{% endif %}
        {% if not access %}<strong class="negative">{{ '· für dich gesperrt'|trans }}</strong>{% endif %}
    </p>

    {% if own %}
        <section class="panel docked">
            <div class="building-head">
                <h2>{{ 'Angedockte Flotten <small class="muted">{visitors}</small>'|trans({'{visitors}': visitors|length + waiting|length|e})|raw }}</h2>
                {% if can_send_away and visitors is not empty %}
                    <form method="post" action="{{ path('app_trade_send_away_all', {id: post.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                        <button class="btn btn-small btn-danger" type="submit" id="send-away-all"
                                data-confirm="{{ 'Alle {visitors} fremden Flotten nach Hause schicken? Treibstoff und Proviant kommen aus dem Lager des Stützpunkts.'|trans({'{visitors}': visitors|length}) }}" data-confirm-label="{{ 'Alle zurückschicken'|trans }}">{{ 'Alle zurückschicken'|trans }}</button>
                    </form>
                {% endif %}
            </div>
            {% if visitors is empty and waiting is empty %}
                <p class="muted small">{{ 'Zurzeit ist keine Flotte angedockt.'|trans }}</p>
            {% else %}
                <table class="table">
                    {% for v in visitors %}
                        <tr>
                            <td>{{ '{label} <span class="muted small">von {owner}</span>'|trans({'{label}': v.fleet.label|trans|e, '{owner}': ui.player(v.fleet.owner)})|raw }}<br>
                                <span class="small">{% for s in v.fleet.shipList %}{{ s.count|num }} × {{ s.type.label|trans }}{{ not loop.last ? ', ' }}{% endfor %}</span></td>
                            <td class="num small">
                                {% if v.plan %}{{ 'nach {name} {coordinates}, {seconds}'|trans({'{name}': v.plan.home.name|e, '{coordinates}': ui.coords(v.plan.home.coordinates), '{seconds}': v.plan.seconds|format_duration|e})|raw }}<br>
                                    {{ 'aus dem Lager: {hydrogen} Wasserstoff, {food} Nahrung, {water} Wasser'|trans({'{hydrogen}': v.plan.cost.hydrogen|num, '{food}': v.plan.cost.food|num, '{water}': v.plan.cost.water|num}) }}{% endif %}
                            </td>
                            <td class="num">
                                {% if can_send_away %}
                                    <form method="post" action="{{ path('app_trade_send_away', {id: post.id, fleet: v.fleet.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                                        <button class="btn btn-small btn-danger" type="submit" id="send-away-{{ v.fleet.id }}">{{ 'Zurückschicken'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    {% for f in waiting %}
                        <tr>
                            <td>{{ '{label} <span class="muted small">(deine Flotte)</span>'|trans({'{label}': f.label|trans|e})|raw }}<br>
                                <span class="small">{% for s in f.shipList %}{{ s.count|num }} × {{ s.type.label|trans }}{{ not loop.last ? ', ' }}{% endfor %}</span></td>
                            <td></td>
                            <td></td>
                        </tr>
                    {% endfor %}
                </table>
                {% if visitors is not empty %}<p class="muted small">{{ 'Zurückgeschickte Flotten fliegen zum Heimatplaneten ihres Besitzers. Treibstoff und Proviant für den Heimflug kommen aus dem Lager dieses Stützpunkts – reicht es nicht, bleibt die Flotte stehen.'|trans }}</p>{% endif %}
            {% endif %}
        </section>
    {% endif %}

    <section class="panel">
        <h2>{{ 'Preise und Lager'|trans }}</h2>
        <table class="table trade-prices">
            <tr class="table-head">
                <td>{{ 'Ware'|trans }}</td>
                <td class="num">{{ 'Lager'|trans }}</td>
                <td class="num">{{ 'Verkauf'|trans }}<br><span class="small">{{ 'Credits/Stück'|trans }}</span></td>
                <td class="num">{{ 'Ankauf'|trans }}<br><span class="small">{{ 'Credits/Stück'|trans }}</span></td>
                <td class="num">{{ 'kauft noch an'|trans }}</td>
            </tr>
            {% for good in goods %}
                {% set resource = true %}
                <tr>
                    <td>{{ good|good_label }}</td>
                    <td class="num">{{ post.stock(good)|num }}</td>
                    <td class="num">{{ post.price(good) > 0 ? post.price(good)|num(2) : '–' }}</td>
                    <td class="num">{{ resource and post.buyPrice(good) > 0 and post.buyLimit(good) > 0 ? post.buyPrice(good)|num(2) : '–' }}</td>
                    <td class="num">{{ resource and post.buyPrice(good) > 0 and post.buyLimit(good) > 0 ? post.buyLimit(good)|num : '–' }}</td>
                </tr>
            {% endfor %}
        </table>
        {% if not post.buysAnything %}<p class="muted small">{{ 'Dieser Stützpunkt kauft zurzeit nichts an.'|trans }}</p>{% endif %}
    </section>

    {% if access %}
        <section class="panel">
            <h2>{{ 'Handeln'|trans }}</h2>
            {% if waiting is empty %}
                <p class="muted">{{ 'Keine deiner Flotten wartet hier. Schicke Handelsschiffe mit „Transport“ (mit Ware zum Verkaufen) oder „Stationieren“ (leer) hierher – sie warten dann am Stützpunkt.'|trans }}</p>
                <a class="btn btn-small" href="{{ path('app_fleet', {galaxy: post.galaxy, system: post.system, position: post.position, mission: 'transport'}) }}">{{ 'Flotte herschicken'|trans }}</a>
            {% else %}
                <form method="post" action="{{ path('app_trade_post_trade', {id: post.id}) }}" class="fleet-form" data-trade-form data-credits="{{ player.credits }}" data-own="{{ own ? 1 : 0 }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                    <label>{{ 'Flotte'|trans }}
                        <select name="fleet">
                            {% for f in waiting %}
                                {% set capacity = 0 %}{% for s in f.shipList %}{% set capacity = capacity + s.type.cargo * s.count %}{% endfor %}
                                <option value="{{ f.id }}" data-free-cargo="{{ max(0, capacity - f.cargo.total) }}">{{ f.label|trans }} – {% for s in f.shipList %}{{ s.count|num }} × {{ s.type.label|trans }}{{ not loop.last ? ', ' }}{% endfor %}{% if not f.cargo.empty %} {{ '– Ladung:'|trans }} {% for r in resources %}{% if f.cargo.get(r) > 0 %}{{ r.label|trans }} {{ f.cargo.get(r)|num }} {% endif %}{% endfor %}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <table class="table">
                        <tr class="table-head"><td>{{ 'Ware'|trans }}</td><td class="num">{{ own ? ('Abholen'|trans) : ('Kaufen'|trans) }}</td><td class="num">{{ own ? ('Einlagern'|trans) : ('Verkaufen'|trans) }}</td></tr>
                        {% for good in goods %}
                            {% set resource = true %}
                            {% set can_buy = (own or post.price(good) > 0) and post.stock(good) > 0 %}
                            {% set can_sell = resource and (own or (post.buyPrice(good) > 0 and post.buyLimit(good) > 0)) %}
                            {% if can_buy or can_sell %}
                                <tr>
                                    <td>{{ good|good_label }}</td>
                                    <td class="num">{% if can_buy %}<input type="number" name="buy[{{ good }}]" min="0" max="{{ post.stock(good)|round(0, 'floor') }}" value="0" aria-label="{{ '{good} kaufen'|trans({'{good}': good|good_label}) }}" class="short"
                                            data-buy-good="{{ good }}" data-stock="{{ post.stock(good)|round(0, 'floor') }}" data-price="{{ own ? 0 : post.price(good) }}" data-cargo="{{ resource ? 1 : 0 }}">
                                        <button type="button" class="btn btn-small btn-secondary" data-buy-max title="{{ 'So viel, wie Frachtraum, Lager und Credits erlauben'|trans }}">{{ 'max'|trans }}</button>{% else %}–{% endif %}</td>
                                    <td class="num">{% if can_sell %}<input type="number" name="sell[{{ good }}]" min="0" value="0" data-sell-good="{{ good }}" aria-label="{{ '{good} verkaufen'|trans({'{good}': good|good_label}) }}" class="short">{% else %}–{% endif %}</td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                    <p class="muted small">
                        {% if own %}{{ 'Als Besitzer lagerst du Ware kostenlos ein und holst sie kostenlos ab.'|trans }}
                        {% else %}{{ 'Erst wird verkauft, dann gekauft. Gehandelt wird höchstens so viel, wie Lager, Ankaufsmenge, Credits und Frachtraum hergeben.'|trans }}{% endif %}
                    </p>
                    <div class="inline-action">
                        <button class="btn" type="submit" id="trade-post-trade">{{ own ? ('Ausführen'|trans) : ('Handeln'|trans) }}</button>
                        <button class="btn btn-secondary" type="submit" name="return" value="1" id="trade-post-trade-return" title="{{ 'Danach fliegt die Flotte zu dem Planeten zurück, von dem sie hergeschickt wurde (sonst zu deinem Hauptplaneten), und lädt dort die Ware ab. Treibstoff und Proviant kommen aus ihrer Ladung.'|trans }}">{{ '{Handeln} und zurückfliegen'|trans({'{Handeln}': own ? ('Ausführen'|trans) : ('Handeln'|trans)}) }}</button>
                    </div>
                </form>
            {% endif %}
        </section>
    {% endif %}

    {% if own and post.active %}
        <section class="panel">
            <h2>{{ 'Stützpunkt verwalten'|trans }}</h2>
            <form method="post" action="{{ path('app_trade_configure', {id: post.id}) }}" class="fleet-form">
                <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                <label>{{ 'Name'|trans }} <input type="text" name="name" value="{{ post.name }}" maxlength="40" required></label>
                <table class="table trade-config">
                    <tr class="table-head">
                        <td>{{ 'Ware'|trans }}</td>
                        <td class="num">{{ 'Verkaufspreis'|trans }}<br><span class="small">{{ '0 = nicht im Verkauf'|trans }}</span></td>
                        <td class="num">{{ 'Ankaufspreis'|trans }}</td>
                        <td class="num">{{ 'Ankaufen bis zu'|trans }}<br><span class="small">{{ '0 = nichts ankaufen'|trans }}</span></td>
                    </tr>
                    {% for good in goods %}
                        {% set resource = true %}
                        <tr>
                            <td>{{ good|good_label }}</td>
                            <td class="num"><input type="number" name="prices[{{ good }}]" min="0" step="0.01" value="{{ post.price(good) }}" class="short" aria-label="{{ 'Verkaufspreis {good}'|trans({'{good}': good|good_label}) }}"></td>
                            <td class="num">{% if resource %}<input type="number" name="buy_prices[{{ good }}]" min="0" step="0.01" value="{{ post.buyPrice(good) }}" class="short" aria-label="{{ 'Ankaufspreis {good}'|trans({'{good}': good|good_label}) }}">{% else %}–{% endif %}</td>
                            <td class="num">{% if resource %}<input type="number" name="buy_limits[{{ good }}]" min="0" step="1" value="{{ post.buyLimit(good)|round(0, 'floor') }}" class="short" aria-label="{{ 'Ankaufsmenge {good}'|trans({'{good}': good|good_label}) }}">{% else %}–{% endif %}</td>
                        </tr>
                    {% endfor %}
                </table>
                <p class="muted small">{{ 'Die Ankaufsmenge ist die Menge, die du noch kaufst: Jeder Ankauf zieht davon ab. Bezahlt wird mit deinen Credits; reichen sie nicht, kaufst du entsprechend weniger.'|trans }}</p>
                <h3>{{ 'Zugang (nichts angehakt = offen für alle)'|trans }}</h3>
                <div class="type-checks">
                    {% for lf in life_forms %}
                        <label><input type="checkbox" name="life_forms[]" value="{{ lf.value }}" {{ lf in post.allowedLifeForms ? 'checked' }}> {{ lf.label|trans }}</label>
                    {% endfor %}
                    {% for a in alliances %}
                        <label><input type="checkbox" name="alliances[]" value="{{ a.id }}" {{ post.allowedAlliances.contains(a) ? 'checked' }}> [{{ a.tag }}] {{ a.name }}</label>
                    {% endfor %}
                </div>
                <button class="btn btn-small" type="submit" id="trade-{{ post.id }}-save">{{ 'Speichern'|trans }}</button>
            </form>

            <form method="post" action="{{ path('app_trade_close', {id: post.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('trade') }}">
                <button class="btn btn-small btn-danger" type="submit" data-confirm="{{ 'Stützpunkt schließen? Das geht nur, wenn das Lager leer ist.'|trans }}" data-confirm-label="{{ 'Schließen'|trans }}">{{ 'Stützpunkt schließen'|trans }}</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
