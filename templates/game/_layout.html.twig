{% extends 'base.html.twig' %}

{% block javascripts %}
    <script src="{{ asset('js/game.js') }}" defer></script>
{% endblock %}

{% macro resource(label, key, amount, rate, protected) %}
    <div class="res res-{{ key }}">
        <span class="res-label">{{ label }}</span>
        <span class="res-amount{{ amount > protected ? ' res-exposed' }}" title="Geschützt: {{ protected|number_format(0, ',', '.') }}"
              data-amount="{{ amount }}" data-rate="{{ rate }}" data-protected="{{ protected }}">{{ amount|number_format(0, ',', '.') }}</span>
        <span class="res-rate{{ rate < 0 ? ' res-negative' }}">{{ rate >= 0 ? '+' }}{{ rate|number_format(0, ',', '.') }}/h</span>
    </div>
{% endmacro %}

{% block body %}
    <header class="topbar">
        <a class="logo logo-small" href="{{ path('app_overview') }}">{{ game_name }}</a>
        <div class="resources">
            {% for type in enum_cases('App\\Game\\ResourceType') %}
                {{ _self.resource(type.label, type.value, planet.resources.get(type), net.get(type), protected) }}
            {% endfor %}
            <div class="res res-credits">
                <span class="res-label">Credits</span>
                <span class="res-amount" data-amount="{{ player.credits }}" data-rate="{{ credits_per_hour }}" data-protected="Infinity">{{ player.credits|number_format(0, ',', '.') }}</span>
                <span class="res-rate">+{{ credits_per_hour|number_format(0, ',', '.') }}/h</span>
            </div>
            <div class="res res-population">
                <span class="res-label">Bevölkerung</span>
                <span class="res-amount">{{ planet.population|number_format(0, ',', '.') }}</span>
                <span class="res-rate">max. {{ population_capacity|number_format(0, ',', '.') }}</span>
            </div>
        </div>
        <div class="user">
            {% if player.alliance %}<a class="alliance-tag" href="{{ path('app_alliance_public', {id: player.alliance.id}) }}">[{{ player.alliance.tag }}]</a> {% endif %}<a href="{{ path('app_player', {id: player.id}) }}" title="Dein Profil">{{ player.lifeForm.icon }} {{ app.user.username }}</a> <span class="muted">({{ player.lifeForm.label }})</span> · <a href="{{ path('app_logout') }}">Abmelden</a>
        </div>
    </header>
    {% set route = app.request.attributes.get('_route') %}
    <div class="layout">
        <nav class="sidebar sidebar-left" aria-label="Navigation">
            <h2 class="sidebar-title">{{ planet.name }}</h2>
            <a href="{{ path('app_overview') }}" class="{{ route == 'app_overview' ? 'active' }}">Übersicht</a>
            <a href="{{ path('app_buildings') }}" class="{{ route == 'app_buildings' ? 'active' }}">Gebäude</a>
            <a href="{{ path('app_queues') }}" class="{{ route == 'app_queues' ? 'active' }}">Bauschleifen</a>
            <a href="{{ path('app_research') }}" class="{{ route == 'app_research' ? 'active' }}">Forschung</a>
            <a href="{{ path('app_shipyard') }}" class="{{ route == 'app_shipyard' ? 'active' }}">Werft</a>

            <h2 class="sidebar-title">Planeten <small>{{ player.planets|length }}</small></h2>
            <div class="planet-list">
                {% for p in player.planets %}
                    <a href="{{ path('app_planet_select', {id: p.id, to: route}) }}" class="planet-badge {{ p.id == planet.id ? 'current' }}" {{ p.id == planet.id ? 'aria-current="true"' }}>
                        <strong>{{ p.name }}</strong>
                        <span>[{{ p.coordinates }}]</span>
                        <span class="planet-status">
                            {%- if p.constructing %}<span title="Gebäude im Bau">🏗</span>{% endif -%}
                            {%- if p.shipyardQueue is not empty %}<span title="Werft arbeitet">🚀</span>{% endif -%}
                            {%- if p.integrating(now) %}<span title="Invadiert, Übergang läuft">⏳</span>{% endif -%}
                        </span>
                    </a>
                {% endfor %}
            </div>
        </nav>
        <main class="content">
            {{ include('_flashes.html.twig') }}
            {% block content %}{% endblock %}
        </main>
        <aside class="sidebar sidebar-right board-column" aria-label="Schwarzes Brett">
            <nav class="empire-nav" aria-label="Imperium">
            <h2 class="sidebar-title">Imperium</h2>
            <a href="{{ path('app_fleet') }}" class="{{ route == 'app_fleet' ? 'active' }}">Flotten</a>
            <a href="{{ path('app_galaxy') }}" class="{{ route == 'app_galaxy' ? 'active' }}">Galaxie</a>
            <a href="{{ path('app_radar') }}" class="{{ route == 'app_radar' ? 'active' }}">Radar</a>
            <a href="{{ path('app_fusion') }}" class="{{ route == 'app_fusion' ? 'active' }}">Fusion</a>
            <a href="{{ path('app_trade') }}" class="{{ route == 'app_trade' ? 'active' }}">Handel</a>
            <a href="{{ path('app_messages') }}" class="{{ route == 'app_messages' ? 'active' }}">
                Nachrichten{% if unread_messages > 0 %} <span class="badge">{{ unread_messages }}</span>{% endif %}
            </a>
            <a href="{{ path('app_lifeform') }}" class="{{ route == 'app_lifeform' ? 'active' }}">Lebensform</a>
            <a href="{{ path('app_alliance') }}" class="{{ route == 'app_alliance' ? 'active' }}">{{ player.alliance ? player.alliance.type : 'Allianz' }}</a>
            </nav>

            <h2 class="sidebar-title">Schwarzes Brett{% if player.alliance %} <small>[{{ player.alliance.tag }}]</small>{% endif %}</h2>
            {% if player.alliance is null %}
                <p class="muted small board-hint">Das schwarze Brett gehört deiner Allianz. Tritt einer bei oder gründe eine – unter <a href="{{ path('app_alliance') }}">Allianz</a>.</p>
            {% elseif not player.allianceRank.canSeeBoard %}
                <p class="muted small board-hint">Als Anwärter hast du noch keinen Zugang zum schwarzen Brett. Sobald dich der Gründer befördert, siehst du es hier.</p>
            {% else %}
                <form method="post" action="{{ path('app_alliance_post') }}" class="board-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('alliance') }}">
                    <input type="hidden" name="to" value="{{ route }}">
                    <textarea name="body" rows="3" maxlength="5000" required aria-label="Neuer Beitrag" placeholder="Nachricht an deine {{ player.alliance.type }} …"></textarea>
                    <button class="btn btn-small" type="submit">Anheften</button>
                </form>
                <div class="board-feed">
                    {% for p in board_posts %}
                        <article class="board-note">
                            <div class="board-meta"><strong>{{ p.author ? p.author.username : 'ehemaliges Mitglied' }}</strong> · {{ p.createdAt|date('d.m. H:i') }}</div>
                            <div class="message-body">{{ p.body }}</div>
                        </article>
                    {% else %}
                        <p class="muted small board-hint">Noch keine Beiträge. Schreib den ersten!</p>
                    {% endfor %}
                </div>
                <a class="small" href="{{ path('app_alliance') }}">Alle Beiträge und Verwaltung →</a>
            {% endif %}
        </aside>
    </div>

    {# Shared confirmation dialog for every button with data-confirm. #}
    <dialog id="confirm-dialog" class="modal" aria-labelledby="confirm-title">
        <form method="dialog">
            <h2 id="confirm-title">Bist du sicher?</h2>
            <p class="modal-text" data-confirm-text></p>
            <div class="modal-actions">
                <button class="btn btn-secondary" value="cancel" autofocus>Abbrechen</button>
                <button class="btn btn-danger" value="confirm" data-confirm-ok>Bestätigen</button>
            </div>
        </form>
    </dialog>
{% endblock %}
