{# Lists the non-zero amounts of a Resources object; amounts the planet can't pay are marked. #}
{% macro cost(cost, planet, multiplier = 1) %}
    {% for type in enum_cases('App\\Game\\ResourceType') %}
        {% set amount = cost.get(type) * multiplier %}
        {% if amount > 0 %}<span class="{{ amount > planet.resources.get(type) ? 'lacking' }}">{{ type.label }} {{ amount|number_format(0, ',', '.') }}</span>{% endif %}
    {% endfor %}
{% endmacro %}

{% macro countdown(finishes_at, now) %}
    <span class="countdown" title="{{ finishes_at|date('d.m.Y H:i:s') }}" data-finishes="{{ finishes_at.timestamp }}" data-now="{{ now.timestamp }}">{{ (finishes_at.timestamp - now.timestamp)|format_duration }}</span>
{% endmacro %}

{# Coordinates "g:s:p" (or "g:s:p-q" of a fusion) as a link to that system in the universe view, slot highlighted. #}
{% macro coords(coordinates) %}
    {%- set parts = coordinates|split(':') -%}
    {%- set position = parts[2]|split('-')|first -%}
    <a class="coords" href="{{ path('app_galaxy', {galaxy: parts[0], system: parts[1]}) }}#slot-{{ position }}" title="Im Universum anzeigen">[{{ coordinates }}]</a>
{%- endmacro %}

{# Exact server time (seconds) for timing fleets; the date only when it is not today. #}
{% macro at(moment, now) %}
    <span class="at">{{ moment|date('d.m.') != now|date('d.m.') ? moment|date('d.m. ') }}{{ moment|date('H:i:s') }}</span>
{% endmacro %}

{# Player name with life form icon, link to the profile and the alliance tag (link to its public page). #}
{% macro player(user, with_alliance = true) %}
    <span class="player-name"><span class="lf-icon" title="{{ user.lifeForm.label }}" aria-label="{{ user.lifeForm.label }}">{{ user.lifeForm.icon }}</span>
    <a href="{{ path('app_player', {id: user.id}) }}">{{ user.username }}</a>
    {%- if with_alliance and user.alliance %} <a class="alliance-tag" href="{{ path('app_alliance_public', {id: user.alliance.id}) }}" title="{{ user.alliance.type }} {{ user.alliance.name }}">[{{ user.alliance.tag }}]</a>{% endif %}</span>
{%- endmacro %}

{# Online status (only shown to alliance mates and quick contacts). #}
{% macro presence(user) %}
    {%- set st = presence(user) -%}
    {%- if st %}<span class="presence {{ st.online ? 'presence-online' : 'presence-offline' }}" title="{{ st.text }}"><span class="presence-dot" aria-hidden="true"></span>{{ st.text }}</span>{% endif -%}
{% endmacro %}

{% macro picture(file, kind, alt, size = 'large') %}
    {% if file %}
        <img class="picture picture-{{ size }}" src="{{ path('app_media', {kind: kind, name: file}) }}" alt="{{ alt }}">
    {% else %}
        <div class="picture picture-{{ size }} picture-empty" aria-hidden="true">{{ alt|first|upper }}</div>
    {% endif %}
{% endmacro %}

{# A value changed by research: the researched value, the base value below if it differs. #}
{% macro ship_stat(label, st) %}
    <div title="{{ st.notes is empty ? 'Grundwert' : 'Grundwert ' ~ st.base|number_format(0, ',', '.') ~ ' – ' ~ st.notes|join(', ') }}">
        <dt>{{ label }}</dt>
        <dd>{{ st.value|number_format(0, ',', '.') }}{% if st.value != st.base %} <small class="stat-base">Basis {{ st.base|number_format(0, ',', '.') }}</small>{% endif %}</dd>
    </div>
{% endmacro %}

