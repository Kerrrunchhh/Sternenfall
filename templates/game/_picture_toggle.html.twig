{# Hides or shows the card pictures (buildings, research, shipyard) – remembered per browser, e.g. off on the phone. #}
<button type="button" class="btn btn-small btn-secondary picture-toggle" data-picture-toggle
        data-label-hide="{{ '🖼 Bilder ausblenden'|trans }}" data-label-show="{{ '🖼 Bilder einblenden'|trans }}"
        title="{{ 'Gilt nur in diesem Browser – z. B. auf dem Handy aus, am PC an.'|trans }}">{{ '🖼 Bilder ausblenden'|trans }}</button>
