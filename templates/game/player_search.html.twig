{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Spieler suchen – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Spieler suchen'|trans }}</h1>
    <form method="get" action="{{ path('app_player_search') }}" class="panel inline-action">
        <input type="text" name="q" value="{{ query }}" minlength="2" required placeholder="{{ 'Name oder Teil des Namens'|trans }}" aria-label="{{ 'Spielername'|trans }}" autofocus>
        <button class="btn btn-small" type="submit" id="player-search">{{ 'Suchen'|trans }}</button>
    </form>
    {% if query|length >= 2 %}
        <section class="panel">
            {% if found is empty %}
                <p class="muted">{{ 'Kein Spieler gefunden.'|trans }}</p>
            {% else %}
                <table class="table">
                    {% for u in found %}
                        <tr>
                            <td>{{ ui.player(u) }}{% if u.onVacation(now) %} <span class="vacation-tag">{{ '🌴 Urlaub'|trans }}</span>{% endif %} {{ ui.presence(u) }}</td>
                            <td class="small muted">{{ u.lifeForm.label|trans }}</td>
                            <td class="num small">{{ '{player_points} Punkte'|trans({'{player_points}': player_points(u)|num}) }}</td>
                            <td class="num"><a class="btn btn-small btn-secondary" href="{{ path('app_mail_compose', {to: u.username}) }}">✉</a></td>
                        </tr>
                    {% endfor %}
                </table>
                {% if found|length == 50 %}<p class="muted small">{{ 'Nur die ersten 50 Treffer – grenze die Suche weiter ein.'|trans }}</p>{% endif %}
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
