{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Forschung – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Forschung'|trans }}</h1>

    {% if player.researching %}
        <div class="panel construction">
            <div>{{ '<strong>In Forschung:</strong> {label} (Stufe {researchTargetLevel})'|trans({'{label}': player.researchType.label|trans|e, '{researchTargetLevel}': player.researchTargetLevel|e})|raw }}</div>
            <div>{{ ui.countdown(player.researchFinishesAt, now) }}</div>
            <form method="post" action="{{ path('app_research_cancel') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('research') }}">
                <button class="btn btn-danger btn-small" type="submit" id="research-cancel"
                        {% if player.researchProgress(now) >= constant('App\\Game\\QueueTimeline::CONFIRM_CANCEL_FROM') %}data-confirm="{{ 'Forschung an {label} (Stufe {researchTargetLevel}) wirklich abbrechen? Die Kosten werden erstattet, der Fortschritt geht verloren.'|trans({'{label}': player.researchType.label|trans, '{researchTargetLevel}': player.researchTargetLevel}) }}"
                        data-confirm-label="{{ 'Forschung abbrechen'|trans }}"{% endif %}>{{ 'Abbrechen'|trans }}</button>
            </form>
        </div>
    {% endif %}

    {% if planet.buildingLevel(enum('App\\Game\\BuildingType').ResearchLab) == 0 %}
        <p class="panel warning">{{ 'Auf diesem Planeten steht noch kein Forschungslabor. Baue eines, um Technologien zu erforschen.'|trans }}</p>
    {% endif %}

    {# One tab per category; the chosen tab is remembered in the browser. #}
    <nav class="tabs" data-tabs="research" aria-label="{{ 'Forschungsbereiche'|trans }}">
        {% for category, items in categories %}
            <button type="button" data-tab-target="research-{{ loop.index }}" class="{{ loop.first ? 'active' }}">
                {{ category|trans }}{% if player.researching and player.researchType.category == category %} <span title="{{ 'Hier wird gerade geforscht'|trans }}">⏳</span>{% endif %}
            </button>
        {% endfor %}
    </nav>
    {% for category, items in categories %}
        <div class="building-list" data-tab-panel="research-{{ loop.index }}" aria-label="{{ category|trans }}">
            {% for r in items %}
                {% set picture = game_picture('research', r.type.value) %}
                <article class="panel building {{ picture ? 'has-picture' }}">
                    {% if picture %}<img class="card-picture" src="{{ asset(picture) }}" alt="{{ r.type.label|trans }}" width="345" height="251" loading="lazy">{% endif %}
                    <div class="card-body">
                    <div class="building-head">
                        <h2>{{ r.type.label|trans }}</h2>
                        <span class="level">{{ 'Stufe {level}'|trans({'{level}': r.level}) }}{% if r.type.maxLevel %} / {{ r.type.maxLevel }}{% endif %}</span>
                    </div>
                    <p class="building-desc">
                        {{ r.type.description|trans }}
                        {% if r.type.value == 'fusion_tech' and r.level > 0 %}<br>{{ 'Aktuell: Fusionen aus höchstens {fusion_capacity} Planeten.'|trans({'{fusion_capacity}': fusion_capacity}) }}{% endif %}
                        {% if r.type.value == 'colonization' %}<br>{{ 'Aktuell: {owned_slots} von {colony_slots} Planetenplätzen belegt.'|trans({'{owned_slots}': owned_slots, '{colony_slots}': colony_slots}) }}{% endif %}
                    </p>
                    <div class="building-foot">
                        <div class="cost">
                            {{ '{cost} <span class="duration">Dauer {seconds}</span>'|trans({'{cost}': ui.cost(r.cost, planet), '{seconds}': r.seconds|format_duration|e})|raw }}
                        </div>
                        {% if r.maxed %}
                            <span class="muted">{{ 'Höchste Stufe erreicht'|trans }}</span>
                        {% elseif r.missing is not empty %}
                            <span class="requirement">{{ 'Benötigt: {missing}'|trans({'{missing}': r.missing|map(m => m|trans)|join(', ')}) }}</span>
                        {% elseif player.researching %}
                            <button class="btn btn-small" disabled>{{ 'Labor belegt'|trans }}</button>
                        {% else %}
                            <form method="post" action="{{ path('app_research_start', {type: r.type.value}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('research') }}">
                                <button class="btn btn-small" type="submit" id="research-{{ r.type.value }}" {{ r.affordable ? '' : 'disabled data-unlock-when-affordable' }}>
                                    {{ r.level == 0 ? 'Erforschen'|trans : 'Stufe {level}'|trans({'{level}': r.level + 1}) }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                </article>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
