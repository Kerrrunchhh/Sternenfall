{% extends 'game/_layout.html.twig' %}

{% block title %}{{ 'Nachrichten – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>{{ 'Nachrichten'|trans }}</h1>
        <form method="post" action="{{ path('app_messages_read_all') }}" data-read-all>
            <input type="hidden" name="_token" value="{{ csrf_token('messages') }}">
            <button class="btn btn-small btn-secondary" type="submit" id="messages-read-all" {% if unread_messages == 0 %}disabled title="{{ 'Alles gelesen'|trans }}"{% endif %}>{{ 'Alle als gelesen markieren'|trans }}</button>
        </form>
    </div>
    <p class="muted small">{{ 'Nachrichten werden nach {keep_days} Tagen automatisch gelöscht.'|trans({'{keep_days}': keep_days}) }}</p>
    {% set token = csrf_token('messages') %}
    {% for m in messages %}
        {# Opening an unread message marks it read (and lowers the counter). #}
        <details class="panel message {{ m.read ? '' : 'unread' }}" {% if not m.read %}data-read-url="{{ path('app_message_read', {id: m.id}) }}" data-token="{{ token }}"{% endif %}>
            <summary>
                <span>{{ m.subject }}</span>
                <span class="muted small">{{ m.createdAt|date('d.m.Y H:i') }}</span>
            </summary>
            <pre class="message-body">{{ m.body|link_coordinates }}</pre>
            <form method="post" action="{{ path('app_message_delete', {id: m.id}) }}" class="message-actions">
                <input type="hidden" name="_token" value="{{ token }}">
                <span class="muted small">{{ 'wird am {createdAt} automatisch gelöscht'|trans({'{createdAt}': m.createdAt|date_modify('+' ~ keep_days ~ ' days')|date('d.m.Y')}) }}</span>
                <button class="btn btn-small btn-danger" type="submit" id="message-delete-{{ m.id }}">{{ 'Löschen'|trans }}</button>
            </form>
        </details>
    {% else %}
        <p class="panel muted">{{ 'Keine Nachrichten.'|trans }}</p>
    {% endfor %}
    {% if pages > 1 %}
        <nav class="pager" aria-label="{{ 'Seiten'|trans }}">
            {% if page > 1 %}<a class="btn btn-small btn-secondary" href="{{ path('app_messages', {page: page - 1}) }}">{{ '← Neuere'|trans }}</a>{% endif %}
            <span class="muted small">{{ 'Seite {page} von {pages} · {total} Nachrichten'|trans({'{page}': page, '{pages}': pages, '{total}': total|num}) }}</span>
            {% if page < pages %}<a class="btn btn-small btn-secondary" href="{{ path('app_messages', {page: page + 1}) }}">{{ 'Ältere →'|trans }}</a>{% endif %}
        </nav>
    {% endif %}
{% endblock %}
