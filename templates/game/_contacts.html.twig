{# Quick contacts with online status, plus requests waiting for an answer. Needs: contacts, incoming_requests, back. #}
{% import 'game/_macros.html.twig' as ui %}
{% if incoming_requests is not empty %}
    <ul class="contact-list contact-requests">
        {% for c in incoming_requests %}
            <li>
                <span>{{ '{requester} <span class="muted small">möchte dein Schnellkontakt werden</span></span> <span class="contact-actions">'|trans({'{requester}': ui.player(c.requester)})|raw }}
                    <form method="post" action="{{ path('app_contact_accept', {id: c.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                        <input type="hidden" name="to" value="{{ back }}">
                        <button class="btn btn-small" type="submit" id="contact-accept-{{ c.id }}">{{ 'Annehmen'|trans }}</button>
                    </form>
                    <form method="post" action="{{ path('app_contact_remove', {id: c.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                        <input type="hidden" name="to" value="{{ back }}">
                        <button class="btn btn-small btn-secondary" type="submit" id="contact-decline-{{ c.id }}">{{ 'Ablehnen'|trans }}</button>
                    </form>
                </span>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% if contacts is empty %}
    <p class="muted small">{{ 'Noch keine Schnellkontakte. Im Profil eines Mitspielers kannst du ihn anfragen; nimmt er an, steht er hier mit seinem Online-Status.'|trans }}</p>
{% else %}
    {# All contacts in one row; a click on the name opens a small menu: write a message or look up the planets. #}
    <ul class="contact-chips">
        {% for c in contacts %}
            {% set st = presence(c) %}
            <li><details class="contact-menu" data-contact-menu>
                <summary class="contact-chip {{ st ? (st.online ? 'presence-online' : 'presence-offline') }}" title="{{ c.username }}{{ st ? ' · ' ~ st.text|trans }}">
                    {%- if st %}<span class="presence-dot" aria-hidden="true"></span>{% endif %}<span aria-hidden="true">{{ c.lifeForm.icon }}</span> {{ c.username -}}
                </summary>
                <ul class="contact-menu-list">
                    <li><a href="{{ path('app_mail_compose', {to: c.username}) }}" id="contact-write-{{ c.id }}">✉️ {{ 'Nachricht senden'|trans }}</a></li>
                    <li><a href="{{ path('app_player', {id: c.id}) }}#planets" id="contact-planets-{{ c.id }}">🪐 {{ 'Planeten & Koordinaten'|trans }}</a></li>
                </ul>
            </details></li>
        {% endfor %}
    </ul>
{% endif %}
