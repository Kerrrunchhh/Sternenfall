{% extends 'game/_layout.html.twig' %}
{% import 'game/_macros.html.twig' as ui %}

{% block title %}{{ 'Auswertung – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h1>{{ 'Handel'|trans }}</h1>
    {{ include('game/_trade_tabs.html.twig') }}

    <section class="panel">
        <h2>{{ 'Auswertung deiner Handelsstützpunkte'|trans }}</h2>
        <p class="muted small">{{ 'Was du an deinen Stützpunkten in den letzten {days} Tagen verkauft und angekauft hast – je Stützpunkt und Handelspartner.'|trans({'{days}': keep_days}) }}</p>
        {% if rows is empty %}
            <p class="muted">{{ trader ? 'Noch keine Geschäfte an deinen Stützpunkten.'|trans : 'Nur Händler betreiben Handelsstützpunkte.'|trans }}</p>
        {% else %}
            <div class="table-scroll">
                <table class="table">
                    <thead><tr><th>{{ 'Stützpunkt'|trans }}</th><th>{{ 'Handelspartner'|trans }}</th><th>{{ 'Verkauft'|trans }}</th><th class="num">{{ 'Einnahmen'|trans }}</th><th>{{ 'Angekauft'|trans }}</th><th class="num">{{ 'Ausgaben'|trans }}</th><th class="num">{{ 'Geschäfte'|trans }}</th></tr></thead>
                    <tbody>
                        {% for r in rows %}
                            <tr>
                                <td><a href="{{ path('app_trade_post', {id: r.post.id}) }}">{{ r.post.name }}</a></td>
                                <td>{{ r.partner }}</td>
                                <td class="small">{% for good, amount in r.sold %}{{ amount|num }} {{ good|good_label|trans }}{{ not loop.last ? ', ' }}{% else %}–{% endfor %}</td>
                                <td class="num trend-up">{{ r.income > 0 ? '+' ~ r.income|num : '–' }}</td>
                                <td class="small">{% for good, amount in r.bought %}{{ amount|num }} {{ good|good_label|trans }}{{ not loop.last ? ', ' }}{% else %}–{% endfor %}</td>
                                <td class="num trend-down">{{ r.spent > 0 ? '−' ~ r.spent|num : '–' }}</td>
                                <td class="num">{{ r.deals }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
