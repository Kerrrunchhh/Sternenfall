{# Figures of the universe. Needs: stats #}
<dl class="stats status-stats">
    <div><dt>{{ 'Spieler'|trans }}</dt><dd>{{ stats.players|num }}</dd></div>
    <div><dt>{{ 'Planeten'|trans }}</dt><dd>{{ stats.planets|num }}</dd></div>
    <div><dt>{{ 'Besiedelte Plätze'|trans }}</dt><dd>{{ stats.colonized_slots|num }}</dd></div>
    <div><dt>{{ 'Unbesiedelte Planeten'|trans }}</dt><dd>{{ stats.free_slots|num }}</dd></div>
    <div><dt>{{ 'Laufende Transporte'|trans }}</dt><dd>{{ stats.transports|num }}</dd></div>
    <div><dt>{{ 'Laufende Angriffe'|trans }}</dt><dd>{{ stats.attacks|num }}</dd></div>
    <div><dt>{{ 'Anmeldungen (24 h)'|trans }}</dt><dd>{{ stats.signups|num }}</dd></div>
    <div><dt>{{ 'Abmeldungen (24 h)'|trans }}</dt><dd>{{ stats.signoffs|num }}</dd></div>
</dl>
