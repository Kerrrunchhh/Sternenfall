{% extends 'security/_layout.html.twig' %}

{% block title %}{{ 'Neues Passwort – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h2>{{ 'Neues Passwort'|trans }}</h2>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.plainPassword) }}
        <button class="btn" type="submit">{{ 'Passwort speichern'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
