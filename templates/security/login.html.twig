{% extends 'security/_layout.html.twig' %}

{% block title %}Anmelden – {{ game_name }}{% endblock %}

{% block content %}
    <h2>Anmelden</h2>
    {% if error %}
        <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post" action="{{ path('app_login') }}">
        <label for="username">Spielername</label>
        <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        <label for="password">Passwort</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn" type="submit">Anmelden</button>
    </form>
    <p class="hint">Noch kein Konto? <a href="{{ path('app_register') }}">Registrieren</a></p>
{% endblock %}
