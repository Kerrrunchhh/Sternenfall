{% extends 'security/_layout.html.twig' %}

{% block title %}{{ 'Passwort vergessen – {game_name}'|trans({'{game_name}': game_name}) }}{% endblock %}

{% block content %}
    <h2>{{ 'Passwort vergessen'|trans }}</h2>
    <p class="muted small">{{ 'Gib die E-Mail-Adresse deines Kontos ein. Wir schicken dir einen Link, mit dem du ein neues Passwort setzt.'|trans }}</p>
    <form method="post" action="{{ path('app_forgot_password') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
        <label for="forgot-email">{{ 'E-Mail-Adresse'|trans }}</label>
        <input type="email" id="forgot-email" name="email" required autocomplete="email" autofocus>
        <button class="btn" type="submit">{{ 'Link senden'|trans }}</button>
    </form>
    {% if dev_link %}<p class="hint">{{ 'Entwicklung (keine Mails):'|trans }} <a href="{{ dev_link }}">{{ 'Link zum Zurücksetzen'|trans }}</a></p>{% endif %}
    <p class="hint"><a href="{{ path('app_login') }}">{{ 'Zur Anmeldung'|trans }}</a></p>
{% endblock %}
