{# Ad slot. Needs: slot ('home' or 'overview'). Google AdSense if configured, otherwise AD_HTML or a placeholder.
   The EU consent banner comes from AdSense itself ("Privacy & messaging"). Extended accounts never get here. #}
<aside class="ad-slot" aria-label="{{ 'Werbung'|trans }}">
    {% if adsense_client and adsense_slots[slot]|default('') %}
        <ins class="adsbygoogle" style="display:block; width:100%" data-ad-client="{{ adsense_client }}" data-ad-slot="{{ adsense_slots[slot] }}" data-ad-format="auto" data-full-width-responsive="true"></ins>
        <script>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    {% elseif ad_html %}
        {{ ad_html|raw }}
    {% else %}
        <span class="muted small">{{ 'Werbefläche'|trans }}</span>
    {% endif %}
    {% if app.user %}<a class="ad-slot-off small" href="{{ path('app_extended') }}">{{ 'Werbefrei mit erweitertem Account'|trans }}</a>{% endif %}
</aside>
