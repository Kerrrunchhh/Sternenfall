# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> game ###
# Name shown in the UI (placeholder, change freely)
GAME_NAME="Starfall: New Horizons"
# Sender address of game e-mails and the developer who gets forwarded suggestions and bug reports.
MAILER_FROM="noreply@example.org"
DEVELOPER_EMAIL=""
# Link to the forum (phpBB) in the game menu; empty hides the menu entry.
FORUM_URL=""
# Multiplier for everything that takes time: production, growth, building, ships, flights and research (1 = normal)
GAME_SPEED=1
# Extra multiplier for research time only, applied on top of GAME_SPEED (2 = research twice as fast)
RESEARCH_SPEED=1
# Extended account (5 €/month) via PayPal subscriptions. Empty = not offered.
# Create a REST app and a subscription plan in the PayPal developer dashboard; the secret belongs in .env.local.
PAYPAL_API="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_PLAN_ID=""
PAYPAL_WEBHOOK_ID=""
# Google AdSense on the start page and the overview (extended accounts see no ads). Empty = placeholder.
# ADSENSE_CLIENT is the publisher id "ca-pub-…", the slots are the ad unit ids from AdSense.
# The EU consent message (CMP) is switched on in AdSense under "Privacy & messaging".
ADSENSE_CLIENT="ca-pub-1661745419492485"
ADSENSE_SLOT_HOME="7904102130"
ADSENSE_SLOT_OVERVIEW="9396972193"
# Other ad code instead of AdSense (raw HTML); only used if ADSENSE_CLIENT is empty.
AD_HTML=""
###< game ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/google-mailer ###
# Gmail SHOULD NOT be used on production, use it in development only.
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
###< symfony/google-mailer ###
